<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the WPF project restore and compile on non-Windows build agents; no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en;zh-Hant;zh-Hans</SatelliteResourceLanguages>
    <Version>0.10.0</Version>
    <Authors>DesktopIconGrid contributors</Authors>
    <Product>Desktop Icon Grid</Product>
  </PropertyGroup>
</Project>
