<Window x:Class="DesktopIconGrid.Views.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync with Google Drive"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <StackPanel Margin="14">

    <!-- Account -->
    <GroupBox Header="Google account" Padding="8">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Connect…" Style="{StaticResource DialogButton}" Command="{Binding ConnectCommand}"
                    Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Disconnect" Style="{StaticResource DialogButton}" Command="{Binding DisconnectCommand}"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>

        <Expander Header="Google API credentials" Margin="0,10,0,0" IsExpanded="{Binding ShowCredentials, Mode=OneWay}">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,0,0,8" Text="{Binding CredentialsHelp}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Client ID:" Margin="0,0,12,8" />
              <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogTextBox}"
                       Text="{Binding ClientId, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsNotConnected}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Client secret:" Margin="0,0,12,8" />
              <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogTextBox}"
                       Text="{Binding ClientSecret, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsNotConnected}" />
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Button Content="Import client_secret.json…" Padding="10,3" Click="ImportCredentials_Click" IsEnabled="{Binding IsNotConnected}" />
              <Button Content="Open Google Cloud Console" Padding="10,3" Margin="8,0,0,0" Command="{Binding OpenConsoleCommand}" />
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </GroupBox>

    <!-- Device -->
    <GroupBox Header="This device" Margin="0,10,0,0" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource DialogLabel}" Text="Device name:" />
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                   Text="Shown to your other devices as the one that saved a copy." />
        <TextBox Padding="4,3" VerticalContentAlignment="Center" MaxLength="64"
                 Text="{Binding DeviceName, UpdateSourceTrigger=LostFocus}" />
      </DockPanel>
    </GroupBox>

    <!-- Copies -->
    <GroupBox Header="Settings copies on Google Drive" Margin="0,10,0,0" Padding="8" IsEnabled="{Binding IsConnected}">
      <StackPanel>
        <ListView Height="150" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
              <GridViewColumn Header="Saved" Width="160" DisplayMemberBinding="{Binding SavedAtLocal, StringFormat=g}" />
              <GridViewColumn Header="Saved by" Width="140" DisplayMemberBinding="{Binding SavedBy}" />
            </GridView>
          </ListView.View>
        </ListView>

        <DockPanel Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource DialogButton}" Command="{Binding RefreshCommand}" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Load" Style="{StaticResource DialogButton}" Margin="0" Command="{Binding LoadCommand}"
                    ToolTip="Replace this device's settings and icons with the selected copy" />
            <Button Content="Overwrite" Style="{StaticResource DialogButton}" Command="{Binding OverwriteCommand}"
                    ToolTip="Replace the selected copy with this device's settings and icons" />
            <Button Content="Delete…" Style="{StaticResource DialogButton}" Command="{Binding DeleteCommand}" />
          </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,10,0,0">
          <TextBlock DockPanel.Dock="Left" Text="Save current settings as:" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource DialogButton}" IsDefault="True" Command="{Binding SaveAsCommand}" />
          <TextBox Padding="4,3" VerticalContentAlignment="Center" MaxLength="80"
                   Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <TextBlock Text="{Binding LinkedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
        <CheckBox Content="Upload my changes to the linked copy automatically" IsChecked="{Binding AutoUpload}" Margin="0,8,0,0" />
        <CheckBox Content="At startup, offer to load the linked copy when another device saved a newer version" IsChecked="{Binding CheckAtStartup}" Margin="0,4,0,0" />
        <Button Content="Unlink this device" Padding="10,3" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding UnlinkCommand}" />
      </StackPanel>
    </GroupBox>

    <!-- Status -->
    <ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="True"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="18" />
    <TextBlock Text="{Binding BackgroundStatus}" Style="{StaticResource DialogHint}" Margin="0,4,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Close" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
