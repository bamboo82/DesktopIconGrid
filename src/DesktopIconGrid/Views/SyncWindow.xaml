<Window x:Class="DesktopIconGrid.Views.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Sync_Title}"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <DockPanel>
    <!-- Close stays in sight; the rest scrolls when the screen is too short for it all. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10,14,14">
      <Button Content="{x:Static r:Strings.Common_Close}" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>

    <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="14,14,14,0">

        <!-- sync.json was locked at start: these settings stand in for it and are not saved -->
        <TextBlock Text="{x:Static r:Strings.Sync_SettingsNotRead}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                   Visibility="{Binding SettingsNotRead, Converter={StaticResource BoolToVisibility}}" />

        <!-- Where the copies are kept: the two choices, and with a folder chosen its row and hint, nothing of it with
             Google Drive (0.16.1 WP2) -->
        <GroupBox x:Name="StorageGroup" Header="{x:Static r:Strings.Sync_Storage}" Padding="8">
          <StackPanel>
            <RadioButton x:Name="GoogleChoice" ContentTemplate="{StaticResource WrappingLabel}" GroupName="Storage" Content="{x:Static r:Strings.Sync_UseGoogle}"
                         IsChecked="{Binding UsesGoogle, Mode=OneWay}" Command="{Binding UseGoogleCommand}" />
            <RadioButton x:Name="FolderChoice" ContentTemplate="{StaticResource WrappingLabel}" GroupName="Storage" Content="{x:Static r:Strings.Sync_UseFolder}" Margin="0,6,0,0"
                         IsChecked="{Binding UsesFolder, Mode=OneWay}" Command="{Binding ChooseFolderCommand}" />
            <DockPanel x:Name="FolderRow" Margin="20,6,0,0" Visibility="{Binding UsesFolder, Converter={StaticResource BoolToVisibility}}">
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Sync_ChooseFolder}" Padding="10,3" Margin="8,0,0,0"
                      Command="{Binding ChooseFolderCommand}" />
              <TextBox IsReadOnly="True" Padding="4,3" VerticalContentAlignment="Center"
                       Text="{Binding SyncFolder, Mode=OneWay}"
                       AutomationProperties.Name="{x:Static r:Strings.Sync_FolderName}" />
            </DockPanel>
            <TextBlock x:Name="FolderHint" Style="{StaticResource DialogHint}" Margin="20,6,0,0" Text="{x:Static r:Strings.Sync_FolderHint}"
                       Visibility="{Binding UsesFolder, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </GroupBox>

        <!-- Google account: copies on Google Drive, and buckets. A short heading, what it is for in a line that wraps:
             the heading of one line was cut at the window's edge in zh-Hant (0.12.2, review 29 N3). Here while Google Drive
             keeps the copies; with a folder its panel moves to the last line, AccountLine (0.16.1 WP2, SyncWindow.PlaceAccount). -->
        <GroupBox x:Name="AccountGroup" Header="{x:Static r:Strings.Sync_AccountForBuckets}" Margin="0,10,0,0" Padding="8"
                  Visibility="{Binding ShowsAccountGroup, Converter={StaticResource BoolToVisibility}}">
          <StackPanel x:Name="AccountPanel">
            <TextBlock x:Name="AccountHint" Style="{StaticResource DialogHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{x:Static r:Strings.Sync_AccountForBucketsHint}" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static r:Strings.Sync_Connect}" Style="{StaticResource DialogButton}" Command="{Binding ConnectCommand}"
                        Visibility="{Binding IsGoogleNotConnected, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{x:Static r:Strings.Sync_Disconnect}" Style="{StaticResource DialogButton}" Command="{Binding DisconnectCommand}"
                        Visibility="{Binding IsGoogleConnected, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>

            <Expander Header="{x:Static r:Strings.Sync_Credentials}" Margin="0,10,0,0" IsExpanded="{Binding ShowCredentials, Mode=OneWay}">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource DialogHint}" Margin="0,0,0,8" Text="{Binding CredentialsHelp}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Sync_ClientId}" Margin="0,0,12,8" />
                  <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogTextBox}"
                           Text="{Binding ClientId, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsGoogleNotConnected}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Sync_ClientSecret}" Margin="0,0,12,8" />
                  <PasswordBox x:Name="SecretBox" Grid.Row="1" Grid.Column="1" Padding="4,3" VerticalContentAlignment="Center"
                               IsEnabled="{Binding IsGoogleNotConnected}" LostFocus="SecretBox_LostFocus"
                               AutomationProperties.Name="{x:Static r:Strings.Sync_ClientSecretName}" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <Button Content="{x:Static r:Strings.Sync_Import}" Padding="10,3" Click="ImportCredentials_Click" IsEnabled="{Binding IsGoogleNotConnected}" />
                  <Button Content="{x:Static r:Strings.Sync_OpenConsole}" Padding="10,3" Margin="8,0,0,0" Command="{Binding OpenConsoleCommand}" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </GroupBox>

        <!-- Device -->
        <GroupBox Header="{x:Static r:Strings.Sync_ThisDevice}" Margin="0,10,0,0" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Sync_DeviceName}" />
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Sync_DeviceNameHint}" />
            <TextBox Padding="4,3" VerticalContentAlignment="Center" MaxLength="64"
                     Text="{Binding DeviceName, UpdateSourceTrigger=LostFocus}" />
          </DockPanel>
        </GroupBox>

        <!-- Copies -->
        <GroupBox Header="{x:Static r:Strings.Sync_Copies}" Margin="0,10,0,0" Padding="8" IsEnabled="{Binding IsConnected}">
          <StackPanel>
            <ListView Height="150" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="{x:Static r:Strings.Common_Name}" Width="230" DisplayMemberBinding="{Binding Name}" />
                  <GridViewColumn Header="{x:Static r:Strings.Sync_Saved}" Width="160" DisplayMemberBinding="{Binding SavedAtLocal, StringFormat=g}" />
                  <GridViewColumn Header="{x:Static r:Strings.Sync_SavedBy}" Width="140" DisplayMemberBinding="{Binding SavedBy}" />
                </GridView>
              </ListView.View>
            </ListView>

            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Refresh}" Style="{StaticResource DialogButton}" Command="{Binding RefreshCommand}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static r:Strings.Common_Load}" Style="{StaticResource DialogButton}" Margin="0" Command="{Binding LoadCommand}"
                        ToolTip="{x:Static r:Strings.Sync_LoadToolTip}" />
                <Button Content="{x:Static r:Strings.Sync_Overwrite}" Style="{StaticResource DialogButton}" Command="{Binding OverwriteCommand}"
                        ToolTip="{x:Static r:Strings.Sync_OverwriteToolTip}" />
                <Button Content="{x:Static r:Strings.Sync_Delete}" Style="{StaticResource DialogButton}" Command="{Binding DeleteCommand}" />
              </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,10,0,0">
              <TextBlock DockPanel.Dock="Left" Text="{x:Static r:Strings.Sync_SaveAs}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Save}" Style="{StaticResource DialogButton}" IsDefault="True" Command="{Binding SaveAsCommand}" />
              <TextBox Padding="4,3" VerticalContentAlignment="Center" MaxLength="80"
                       Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <TextBlock Text="{Binding LinkedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Sync_AutoUpload}" IsChecked="{Binding AutoUpload}" Margin="0,8,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Sync_OfferNewer}" IsChecked="{Binding CheckAtStartup}" Margin="0,4,0,0" />
            <Button Content="{x:Static r:Strings.Sync_UnlinkDevice}" Padding="10,3" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding UnlinkCommand}" />
          </StackPanel>
        </GroupBox>

        <!-- The Google account with a folder in use, while buckets may need it (0.16.1 WP2): the last section, one line
             closed at first with the account's state at its right; opened, the account's panel from above. Shown while an
             account is connected, a sign-in is under way or a bucket icon is on the bar; it opens by itself while a
             sign-in runs and when one fails. -->
        <Expander x:Name="AccountLine" Margin="0,10,0,0"
                  Visibility="{Binding ShowsAccountLine, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{x:Static r:Strings.Sync_AccountForBucketsLine}"
                  AutomationProperties.HelpText="{Binding ConnectionText}">
          <Expander.Header>
            <DockPanel x:Name="AccountLineHeader">
              <TextBlock x:Name="AccountLineState" DockPanel.Dock="Right" Style="{StaticResource DialogHint}" Margin="12,0,0,0"
                         VerticalAlignment="Center" Text="{Binding ConnectionText}" />
              <TextBlock x:Name="AccountLineTitle" Text="{x:Static r:Strings.Sync_AccountForBucketsLine}" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Expander.Header>
        </Expander>

        <!-- Status -->
        <ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <!-- A problem is said once: the fuller of the two lines when one holds the other (0.12.2, review 29 N4) -->
        <TextBlock Text="{Binding ShownStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="18" />
        <TextBlock Text="{Binding ShownBackgroundStatus}" Style="{StaticResource DialogHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
