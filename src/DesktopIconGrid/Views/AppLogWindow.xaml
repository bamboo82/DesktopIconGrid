<Window x:Class="DesktopIconGrid.Views.AppLogWindow"
        x:Name="LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Log_Title}"
        Width="960"
        Height="600"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Icon="{StaticResource AppIconImage}"
        Closed="Window_Closed">
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusFilterCommand, ElementName=LogWindow}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand, ElementName=LogWindow}" />
    <KeyBinding Key="End" Modifiers="Control" Command="{Binding ScrollToEndCommand, ElementName=LogWindow}" />
  </Window.InputBindings>
  <DockPanel Margin="10">
    <!-- Filters -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <ComboBox Width="170" Margin="0,0,6,4" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" DisplayMemberPath="Label" VerticalContentAlignment="Center" ToolTip="{x:Static r:Strings.Log_MinLevelToolTip}" />
      <ComboBox Width="140" Margin="0,0,6,4" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" VerticalContentAlignment="Center" ToolTip="{x:Static r:Strings.Log_Category}" />
      <ComboBox Width="130" Margin="0,0,6,4" ItemsSource="{Binding Ranges}" SelectedItem="{Binding TimeRange}" DisplayMemberPath="Label" VerticalContentAlignment="Center" ToolTip="{x:Static r:Strings.Log_TimeRangeToolTip}" />
      <TextBox x:Name="FilterBox" Width="220" Margin="0,0,6,4" Padding="4,3" VerticalContentAlignment="Center"
               Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{x:Static r:Strings.Log_SearchToolTip}"
               KeyDown="FilterBox_KeyDown" />
      <Button Content="{x:Static r:Strings.Log_Reset}" Padding="10,3" Margin="0,0,12,4" Command="{Binding ResetFiltersCommand}" ToolTip="{x:Static r:Strings.Log_ResetToolTip}" />
      <CheckBox Content="{x:Static r:Strings.Log_Follow}" IsChecked="{Binding FollowTail}" VerticalAlignment="Center" Margin="0,0,12,4" ToolTip="{x:Static r:Strings.Log_FollowToolTip}" />
      <Button Content="{x:Static r:Strings.Log_Copy}" Padding="10,3" Margin="0,0,6,4" Command="{Binding CopyCommand}" ToolTip="{x:Static r:Strings.Log_CopyToolTip}" />
      <Button Content="{x:Static r:Strings.Log_SaveAs}" Padding="10,3" Margin="0,0,6,4" Click="Save_Click" ToolTip="{x:Static r:Strings.Log_SaveAsToolTip}" />
      <Button Content="{x:Static r:Strings.Log_OpenFile}" Padding="10,3" Margin="0,0,6,4" Click="OpenFile_Click" ToolTip="{x:Static r:Strings.Log_OpenFileToolTip}" />
      <Button Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="0,0,0,4" Command="{Binding ClearCommand}" ToolTip="{x:Static r:Strings.Log_ClearToolTip}" />
    </WrapPanel>

    <!-- Status and details -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,6,0,0" Style="{StaticResource DialogHint}" />
    <TextBox DockPanel.Dock="Bottom" Height="72" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Segoe UI" FontSize="12" Padding="4"
             Text="{Binding DetailText, Mode=OneWay}" />

    <ListView x:Name="Entries" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
              SelectionMode="Extended" FontFamily="Consolas, Segoe UI" FontSize="12"
              MouseDoubleClick="Entries_MouseDoubleClick" KeyDown="Entries_KeyDown">
      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static r:Strings.Log_CopyLine}" Command="{Binding CopyLineCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="{x:Static r:Strings.Log_CopyMessage}" Command="{Binding CopyMessageCommand}" CommandParameter="{Binding Selected}" />
          <Separator />
          <MenuItem Header="{x:Static r:Strings.Log_OnlyCategory}" Command="{Binding OnlyThisCategoryCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="{x:Static r:Strings.Log_ResetFilters}" Command="{Binding ResetFiltersCommand}" />
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="ToolTip" Value="{Binding Message}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDebug}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource DialogHintBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{x:Static r:Strings.Log_Date}" Width="90" DisplayMemberBinding="{Binding DateText}" />
          <GridViewColumn Header="{x:Static r:Strings.Log_Time}" Width="96" DisplayMemberBinding="{Binding TimeText}" />
          <GridViewColumn Header="{x:Static r:Strings.Log_Level}" Width="70" DisplayMemberBinding="{Binding LevelText}" />
          <GridViewColumn Header="{x:Static r:Strings.Log_Category}" Width="90" DisplayMemberBinding="{Binding Category}" />
          <GridViewColumn Header="{x:Static r:Strings.Log_Message}" Width="640" DisplayMemberBinding="{Binding Message}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
