<Window x:Class="DesktopIconGrid.Views.AppLogWindow"
        x:Name="LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log viewer — Desktop Icon Grid"
        Width="960"
        Height="600"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Icon="{StaticResource AppIconImage}"
        Closed="Window_Closed">
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusFilterCommand, ElementName=LogWindow}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand, ElementName=LogWindow}" />
    <KeyBinding Key="End" Modifiers="Control" Command="{Binding ScrollToEndCommand, ElementName=LogWindow}" />
  </Window.InputBindings>
  <DockPanel Margin="10">
    <!-- Filters -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <ComboBox Width="170" Margin="0,0,6,4" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" DisplayMemberPath="Label" VerticalContentAlignment="Center" ToolTip="Minimum level" />
      <ComboBox Width="140" Margin="0,0,6,4" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" VerticalContentAlignment="Center" ToolTip="Category" />
      <ComboBox Width="130" Margin="0,0,6,4" ItemsSource="{Binding Ranges}" SelectedItem="{Binding TimeRange}" DisplayMemberPath="Label" VerticalContentAlignment="Center" ToolTip="Time range" />
      <TextBox x:Name="FilterBox" Width="220" Margin="0,0,6,4" Padding="4,3" VerticalContentAlignment="Center"
               Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Show only entries containing this text (Ctrl+F, Esc clears)"
               KeyDown="FilterBox_KeyDown" />
      <Button Content="Reset" Padding="10,3" Margin="0,0,12,4" Command="{Binding ResetFiltersCommand}" ToolTip="Clear all filters" />
      <CheckBox Content="Follow" IsChecked="{Binding FollowTail}" VerticalAlignment="Center" Margin="0,0,12,4" ToolTip="Keep the newest entry in view" />
      <Button Content="Copy" Padding="10,3" Margin="0,0,6,4" Command="{Binding CopyCommand}" ToolTip="Copy the visible entries to the clipboard" />
      <Button Content="Save as…" Padding="10,3" Margin="0,0,6,4" Click="Save_Click" ToolTip="Save the visible entries to a text file (Ctrl+S)" />
      <Button Content="Open log file" Padding="10,3" Margin="0,0,6,4" Click="OpenFile_Click" ToolTip="Open app.log in the default text editor" />
      <Button Content="Clear" Padding="10,3" Margin="0,0,0,4" Command="{Binding ClearCommand}" ToolTip="Empty the in-memory log (the file is kept)" />
    </WrapPanel>

    <!-- Status and details -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,6,0,0" Style="{StaticResource DialogHint}" />
    <TextBox DockPanel.Dock="Bottom" Height="72" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Segoe UI" FontSize="12" Padding="4"
             Text="{Binding DetailText, Mode=OneWay}" />

    <ListView x:Name="Entries" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
              SelectionMode="Extended" FontFamily="Consolas, Segoe UI" FontSize="12"
              MouseDoubleClick="Entries_MouseDoubleClick" KeyDown="Entries_KeyDown">
      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy line" Command="{Binding CopyLineCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="Copy message" Command="{Binding CopyMessageCommand}" CommandParameter="{Binding Selected}" />
          <Separator />
          <MenuItem Header="Show only this category" Command="{Binding OnlyThisCategoryCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="Reset filters" Command="{Binding ResetFiltersCommand}" />
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="ToolTip" Value="{Binding Message}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDebug}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource DialogHintBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Foreground" Value="#FFC62828" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding DateText}" />
          <GridViewColumn Header="Time" Width="96" DisplayMemberBinding="{Binding TimeText}" />
          <GridViewColumn Header="Level" Width="70" DisplayMemberBinding="{Binding LevelText}" />
          <GridViewColumn Header="Category" Width="90" DisplayMemberBinding="{Binding Category}" />
          <GridViewColumn Header="Message" Width="640" DisplayMemberBinding="{Binding Message}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
