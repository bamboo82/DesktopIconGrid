<Window x:Class="DesktopIconGrid.Views.PictureAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Picture_WebTitle}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        FocusManager.FocusedElement="{Binding ElementName=AddressBox}">
  <!-- One https:// address for the background picture (0.15.0 WP5): fetched when OK is pressed, once; why it failed is said here -->
  <StackPanel Margin="14">
    <TextBlock Text="{x:Static r:Strings.Picture_WebPrompt}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox x:Name="AddressBox" Padding="4,3" VerticalContentAlignment="Center"
             AutomationProperties.Name="{x:Static r:Strings.Picture_WebPrompt}" />
    <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OkButton" Content="{x:Static r:Strings.Common_OK}" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
      <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
