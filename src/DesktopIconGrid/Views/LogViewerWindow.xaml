<Window x:Class="DesktopIconGrid.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{Binding Title}"
        Width="720"
        Height="460"
        MinWidth="360"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{x:Static r:Strings.Log_OpenFile}" Padding="10,3" Command="{Binding OpenFileCommand}" />
        <Button Content="{x:Static r:Strings.Log_OpenFolder}" Padding="10,3" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Header}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource DialogHint}" Margin="0,0,0,8"
               Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}" />

    <TextBox x:Name="Output"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Consolas, Courier New"
             FontSize="12"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             Background="#FF1E1E1E"
             Foreground="#FFDCDCDC"
             Padding="6" />
  </DockPanel>
</Window>
