<Window x:Class="DesktopIconGrid.Views.NameTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Names_Title}"
        Width="860"
        Height="520"
        MinWidth="520"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Style="{StaticResource DialogHint}" Margin="0,0,0,8" />

    <!-- Colour-tag filter -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{x:Static r:Strings.Names_Show}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox MinWidth="180" ItemsSource="{Binding TagFilters}" SelectedItem="{Binding SelectedTagFilter}"
                AutomationProperties.Name="{x:Static r:Strings.Names_ShowName}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="12" Height="12" Margin="0,0,6,0" Fill="{Binding Brush}" RadiusX="2" RadiusY="2"
                         Visibility="{Binding Brush, Converter={StaticResource NullToCollapsed}}" />
              <TextBlock Text="{Binding Name}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{x:Static r:Strings.Common_Save}" Style="{StaticResource DialogButton}" IsDefault="True" Click="Save_Click" />
        <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="{x:Static r:Strings.Names_UseOriginal}" Padding="10,3" Click="UseOriginal_Click" ToolTip="{x:Static r:Strings.Names_ResetToolTip}" />
        <Button Content="{x:Static r:Strings.Names_UseOriginalAll}" Padding="10,3" Margin="8,0,0,0" Command="{Binding UseOriginalForAllCommand}" />
      </StackPanel>
    </DockPanel>

    <DataGrid x:Name="Grid"
              ItemsSource="{Binding RowsView}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              CanUserResizeRows="False"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowHeight="26"
              IsReadOnly="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static r:Strings.Names_Given}" Width="200" SortMemberPath="GivenName"
                            Binding="{Binding GivenName, UpdateSourceTrigger=PropertyChanged}" />
        <DataGridTextColumn Header="{x:Static r:Strings.Names_Original}" Width="180" IsReadOnly="True" Binding="{Binding OriginalName}" />
        <DataGridTextColumn Header="{x:Static r:Strings.Names_Kind}" Width="110" IsReadOnly="True" Binding="{Binding Kind}" />
        <DataGridTextColumn Header="{x:Static r:Strings.Names_InGroup}" Width="110" IsReadOnly="True" Binding="{Binding GroupName}" />
        <DataGridTemplateColumn Header="{x:Static r:Strings.Names_ColorTag}" Width="110" IsReadOnly="True" SortMemberPath="ColorTagName">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <Rectangle Width="12" Height="12" Margin="0,0,6,0" Fill="{Binding ColorTagBrush}" RadiusX="2" RadiusY="2"
                           Visibility="{Binding ColorTagBrush, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding ColorTagName}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static r:Strings.Common_Modified}" Width="140" IsReadOnly="True" SortMemberPath="ModifiedAt"
                            Binding="{Binding ModifiedAt, StringFormat=g}" />
        <DataGridTextColumn Header="{x:Static r:Strings.Common_Location}" Width="*" IsReadOnly="True" Binding="{Binding Location}" />
      </DataGrid.Columns>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChanged}" Value="True">
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
    </DataGrid>
  </DockPanel>
</Window>
