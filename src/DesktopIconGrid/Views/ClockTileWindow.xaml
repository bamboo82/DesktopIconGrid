<Window x:Class="DesktopIconGrid.Views.ClockTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Clock_Name}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="90" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Common_NameLabel}" Margin="0,0,12,8" />
    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogTextBox}"
             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="1" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Clock_Zone}" Margin="0,0,12,8" />
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" VerticalContentAlignment="Center"
              ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" DisplayMemberPath="Label"
              AutomationProperties.Name="{x:Static r:Strings.Clock_Zone}" />

    <TextBlock Grid.Row="2" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Clock_OnClick}" Margin="0,0,12,8" />
    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" VerticalContentAlignment="Center"
              ItemsSource="{Binding Timers}" SelectedItem="{Binding SelectedTimer}" DisplayMemberPath="Label"
              AutomationProperties.Name="{x:Static r:Strings.Clock_OnClick}" />

    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8"
                Visibility="{Binding HasTimer, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Clock_Minutes}" Margin="0,0,6,0" />
      <TextBox Style="{StaticResource DialogTextBox}" Width="60" Margin="0,0,16,0" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{x:Static r:Strings.Clock_Minutes}" />
      <TextBlock Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Clock_BreakMinutes}" Margin="0,0,6,0"
                 Visibility="{Binding IsPomodoro, Converter={StaticResource BoolToVisibility}}" />
      <TextBox Style="{StaticResource DialogTextBox}" Width="60" Margin="0" Text="{Binding BreakMinutes, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{x:Static r:Strings.Clock_BreakMinutes}"
               Visibility="{Binding IsPomodoro, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{x:Static r:Strings.Common_OK}" Style="{StaticResource DialogButton}" IsDefault="True" IsEnabled="{Binding CanSave}" Click="Ok_Click" />
      <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
