<Window x:Class="DesktopIconGrid.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Settings_Title}"
        Width="490"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="100" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Theme -->
    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Theme}" Margin="0,0,12,10" />
    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
      <Border DockPanel.Dock="Right" Width="26" Height="26" Margin="8,0,0,0"
              Background="{Binding PreviewBrush}"
              BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1" CornerRadius="3"
              ToolTip="{x:Static r:Strings.Settings_BarBackgroundToolTip}" />
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" VerticalContentAlignment="Center"
                AutomationProperties.Name="{x:Static r:Strings.Settings_ThemeName}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Border Width="14" Height="14" Margin="0,0,8,0" CornerRadius="2"
                      Background="{Binding Background}"
                      BorderBrush="{Binding Border}" BorderThickness="1" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DockPanel>

    <!-- Custom background -->
    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Background}" Margin="0,0,12,10" VerticalAlignment="Top"
               IsEnabled="{Binding IsCustomTheme}" />
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
      <StackPanel Orientation="Horizontal">
        <TextBox Width="96" Padding="4,3" VerticalContentAlignment="Center"
                 Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{x:Static r:Strings.Settings_BackgroundColourName}" />
        <TextBlock Text="{x:Static r:Strings.Settings_UseHex}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                   Visibility="{Binding IsColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
        <TextBlock Text="{x:Static r:Strings.Settings_ColourHint}" Style="{StaticResource DialogHint}" Margin="10,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding IsColorValid, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Presets}" Margin="0,8,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="24" Height="24" Margin="0,0,6,6" Padding="0"
                    Background="{Binding}"
                    BorderBrush="{DynamicResource SwatchBorderBrush}"
                    ToolTip="{Binding}"
                    AutomationProperties.Name="{Binding}"
                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="3" />
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Bar background (Windows 11 backdrop) -->
    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_BarBackground}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
      <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                ItemsSource="{Binding Backdrops}" SelectedItem="{Binding SelectedBackdrop}" DisplayMemberPath="Name"
                IsEnabled="{Binding IsBackdropSupported}"
                AutomationProperties.Name="{x:Static r:Strings.Settings_BarBackgroundToolTip}" />
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{Binding BackdropHint}" />
    </StackPanel>

    <!-- Icon size -->
    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_IconSize}" Margin="0,0,12,10" />
    <ComboBox Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10"
              ItemsSource="{Binding IconSizes}"
              SelectedItem="{Binding IconSize}"
              ItemStringFormat="{}{0} px"
              AutomationProperties.Name="{x:Static r:Strings.Settings_IconSizeName}" />

    <!-- Spacing -->
    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Spacing}" Margin="0,0,12,10" />
    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CellPaddingText}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
      <Slider Minimum="{Binding MinCellPadding}" Maximum="{Binding MaxCellPadding}"
              Value="{Binding CellPadding}"
              IsSnapToTickEnabled="True" TickFrequency="1"
              VerticalAlignment="Center" Margin="0,0,10,0"
              AutomationProperties.Name="{x:Static r:Strings.Settings_SpacingName}" />
    </DockPanel>

    <!-- Labels -->
    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Labels}" Margin="0,0,12,10" />
    <CheckBox Grid.Row="5" Grid.Column="1" Content="{x:Static r:Strings.Settings_ShowLabels}" IsChecked="{Binding ShowLabels}" Margin="0,0,0,10" VerticalAlignment="Center" />

    <!-- Launch -->
    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_OpenWith}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
      <RadioButton Content="{x:Static r:Strings.Settings_SingleClick}" GroupName="Launch" IsChecked="{Binding SingleClickToLaunch}" />
      <RadioButton Content="{x:Static r:Strings.Settings_DoubleClick}" GroupName="Launch" IsChecked="{Binding DoubleClickToLaunch}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- Window -->
    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Window}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
      <CheckBox Content="{x:Static r:Strings.Menu_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" />
      <CheckBox Content="{x:Static r:Strings.Settings_CloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0" />
      <CheckBox Content="{x:Static r:Strings.Settings_FluentDialogs}" IsChecked="{Binding FluentDialogs}" Margin="0,4,0,0" />
      <CheckBox Content="{x:Static r:Strings.Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />
      <CheckBox Content="{x:Static r:Strings.Settings_StartHidden}" IsChecked="{Binding StartHidden}"
                IsEnabled="{Binding StartWithWindows}" Margin="22,4,0,0" />
    </StackPanel>

    <!-- Dock to a screen edge -->
    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_DockToEdge}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
      <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                ItemsSource="{Binding DockEdges}" SelectedItem="{Binding SelectedDockEdge}" DisplayMemberPath="Name"
                AutomationProperties.Name="{x:Static r:Strings.Settings_DockToEdgeName}" />
      <CheckBox Content="{x:Static r:Strings.Settings_AutoHide}"
                IsChecked="{Binding AutoHide}" IsEnabled="{Binding IsDocked}" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                 Text="{x:Static r:Strings.Settings_DockHint}" />
    </StackPanel>

    <!-- Transparency -->
    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Transparency}" Margin="0,0,12,10" />
    <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Right" Text="{Binding TransparencyText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" />
      <Slider Minimum="0" Maximum="{Binding MaxTransparency}"
              Value="{Binding Transparency}"
              IsSnapToTickEnabled="True" TickFrequency="5"
              VerticalAlignment="Center" Margin="0,0,10,0"
              ToolTip="{x:Static r:Strings.Settings_TransparencyToolTip}"
              AutomationProperties.Name="{x:Static r:Strings.Settings_TransparencyName}" />
    </DockPanel>

    <!-- Hotkey -->
    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Hotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearHotkey_Click"
                IsEnabled="{Binding HasHotkey}" />
        <TextBox x:Name="HotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                 Text="{Binding ToggleHotkey, Mode=OneWay}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                 AutomationProperties.Name="{x:Static r:Strings.Settings_HotkeyName}" />
      </DockPanel>
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                 Text="{x:Static r:Strings.Settings_HotkeyHint}" />
      <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>

    <!-- Show-at-pointer hotkey -->
    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_PointerHotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="11" Grid.Column="1" Margin="0,0,0,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearPointerHotkey_Click"
                IsEnabled="{Binding HasPointerHotkey}" />
        <TextBox x:Name="PointerHotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                 Text="{Binding ShowAtPointerHotkey, Mode=OneWay}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                 AutomationProperties.Name="{x:Static r:Strings.Settings_PointerHotkeyName}" />
      </DockPanel>
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                 Text="{x:Static r:Strings.Settings_PointerHotkeyHint}" />
      <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                 Text="{x:Static r:Strings.Settings_PointerHotkeySame}"
                 Visibility="{Binding IsPointerHotkeySame, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock x:Name="PointerHotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>

    <!-- Language -->
    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Language}" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,0,0,10">
      <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                AutomationProperties.Name="{x:Static r:Strings.Settings_LanguageName}" />
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{x:Static r:Strings.Settings_LanguageHint}" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="{x:Static r:Strings.Common_Save}" Style="{StaticResource DialogButton}" IsDefault="True"
              IsEnabled="{Binding CanSave}" Click="Save_Click" />
      <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
