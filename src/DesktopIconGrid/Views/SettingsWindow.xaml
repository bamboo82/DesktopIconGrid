<Window x:Class="DesktopIconGrid.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Settings_Title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="{StaticResource AppIconImage}">
  <!--
    Five tabs (review 27 B1). The tab strip only chooses; the five pages lie on top of each other in one cell below it,
    the hidden ones still measured, so the page area is as tall as the tallest page (each at most 560) and the window
    does not jump when the tab changes. On a shorter screen every page scrolls, with Save and Cancel still in sight.
    Each page is its own Grid with exactly the rows it uses.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl x:Name="Tabs" Grid.Row="0" Margin="14,14,14,0" Padding="0" BorderThickness="0,1,0,0"
                SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="{Binding AppearanceTab}" />
      <TabItem Header="{Binding WindowTab}" />
      <TabItem Header="{Binding KeysTab}" />
      <TabItem Header="{Binding VoiceTab}" />
      <TabItem Header="{Binding GeneralTab}" />
    </TabControl>

    <Grid x:Name="Pages" Grid.Row="1" Margin="0,12,0,0">

      <!-- ===== Appearance ===== -->
      <ScrollViewer x:Name="AppearancePage" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabAppearance}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Theme -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Theme}" Margin="0,0,12,10" />
          <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Width="26" Height="26" Margin="8,0,0,0"
                    Background="{Binding PreviewBrush}"
                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1" CornerRadius="3"
                    ToolTip="{x:Static r:Strings.Settings_BarBackgroundToolTip}" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" VerticalContentAlignment="Center"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_ThemeName}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" Margin="0,0,8,0" CornerRadius="2"
                            Background="{Binding Background}"
                            BorderBrush="{Binding Border}" BorderThickness="1" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>

          <!-- Custom background -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Background}" Margin="0,0,12,10" VerticalAlignment="Top"
                     IsEnabled="{Binding IsCustomTheme}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <StackPanel Orientation="Horizontal">
              <TextBox Width="96" Padding="4,3" VerticalContentAlignment="Center"
                       Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_BackgroundColourName}" />
              <TextBlock Text="{x:Static r:Strings.Settings_UseHex}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                         Visibility="{Binding IsColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
              <TextBlock Text="{x:Static r:Strings.Settings_ColourHint}" Style="{StaticResource DialogHint}" Margin="10,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding IsColorValid, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,8,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="24" Height="24" Margin="0,0,6,6" Padding="0"
                          Background="{Binding}"
                          BorderBrush="{DynamicResource SwatchBorderBrush}"
                          ToolTip="{Binding}"
                          AutomationProperties.Name="{Binding}"
                          Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3" />
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Bar background (Windows 11 backdrop) -->
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_BarBackground}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Backdrops}" SelectedItem="{Binding SelectedBackdrop}" DisplayMemberPath="Name"
                      IsEnabled="{Binding IsBackdropSupported}"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_BarBackgroundToolTip}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{Binding BackdropHint}" />
          </StackPanel>

          <!-- Icon size -->
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_IconSize}" Margin="0,0,12,10" />
          <ComboBox Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10"
                    ItemsSource="{Binding IconSizes}"
                    SelectedItem="{Binding IconSize}"
                    ItemStringFormat="{}{0} px"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_IconSizeName}" />

          <!-- Spacing -->
          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Spacing}" Margin="0,0,12,10" />
          <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CellPaddingText}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider Minimum="{Binding MinCellPadding}" Maximum="{Binding MaxCellPadding}"
                    Value="{Binding CellPadding}"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_SpacingName}" />
          </DockPanel>

          <!-- Labels -->
          <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Labels}" Margin="0,0,12,10" />
          <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Grid.Row="5" Grid.Column="1" Content="{x:Static r:Strings.Settings_ShowLabels}" IsChecked="{Binding ShowLabels}" Margin="0,0,0,10" VerticalAlignment="Center" />

          <!-- Transparency -->
          <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Transparency}" Margin="0,0,12,10" />
          <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding TransparencyText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider Minimum="0" Maximum="{Binding MaxTransparency}"
                    Value="{Binding Transparency}"
                    IsSnapToTickEnabled="True" TickFrequency="5"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    ToolTip="{x:Static r:Strings.Settings_TransparencyToolTip}"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TransparencyName}" />
          </DockPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Window ===== -->
      <ScrollViewer x:Name="WindowPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabWindow}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Launch -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_OpenWith}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <RadioButton ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_SingleClick}" GroupName="Launch" IsChecked="{Binding SingleClickToLaunch}" />
            <RadioButton ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_DoubleClick}" GroupName="Launch" IsChecked="{Binding DoubleClickToLaunch}" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Window -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Window}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Menu_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_CloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_FluentDialogs}" IsChecked="{Binding FluentDialogs}" Margin="0,4,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_StartHidden}" IsChecked="{Binding StartHidden}"
                      IsEnabled="{Binding StartWithWindows}" Margin="22,4,0,0" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="22,4,0,0" Text="{x:Static r:Strings.Settings_StartupDisabledHint}" />
          </StackPanel>

          <!-- Dock to a screen edge -->
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_DockToEdge}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding DockEdges}" SelectedItem="{Binding SelectedDockEdge}" DisplayMemberPath="Name"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_DockToEdgeName}" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_AutoHide}"
                      IsChecked="{Binding AutoHide}" IsEnabled="{Binding IsDocked}" Margin="0,6,0,0" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_DockHint}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Keys ===== -->
      <ScrollViewer x:Name="KeysPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabKeys}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Show/hide hotkey -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Hotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearHotkey_Click"
                      IsEnabled="{Binding HasHotkey}" />
              <TextBox x:Name="HotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding ToggleHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_HotkeyName}" />
            </DockPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_HotkeyHint}" />
            <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding ToggleHotkeyClash}"
                       Visibility="{Binding HasToggleHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Show-at-pointer hotkey -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_PointerHotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearPointerHotkey_Click"
                      IsEnabled="{Binding HasPointerHotkey}" />
              <TextBox x:Name="PointerHotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding ShowAtPointerHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_PointerHotkeyName}" />
            </DockPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_PointerHotkeyHint}" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Text="{x:Static r:Strings.Settings_PointerHotkeySame}"
                       Visibility="{Binding IsPointerHotkeySame, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="PointerHotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding PointerHotkeyClash}"
                       Visibility="{Binding HasPointerHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Keys in the bar (WindowKeyMap): the table takes the full width -->
          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_WindowKeys}" Margin="0,4,0,6" />
          <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding WindowKeyRows}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Settings_WindowKeyDefault}" Padding="10,3" Margin="8,0,0,0"
                            Click="WindowKeyDefault_Click" IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBool}}"
                            AutomationProperties.Name="{Binding Label}" />
                    <TextBox DockPanel.Dock="Right" Width="140" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                             Text="{Binding Text, Mode=OneWay}" PreviewKeyDown="WindowKeyBox_PreviewKeyDown"
                             AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_WindowKeysHint}" />
            <TextBlock x:Name="WindowKeyWarning" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Voice ===== -->
      <ScrollViewer x:Name="VoicePage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabVoice}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Voice hotkey -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_VoiceHotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearVoiceHotkey_Click"
                      IsEnabled="{Binding HasVoiceHotkey}" />
              <TextBox x:Name="VoiceHotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding VoiceHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_VoiceHotkeyName}" />
            </DockPanel>
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_VoiceHotkeySame}"
                       Visibility="{Binding IsVoiceHotkeySame, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="VoiceHotkeyWarning" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding VoiceHotkeyClash}"
                       Visibility="{Binding HasVoiceHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Voice language -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_VoiceLanguage}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="260" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding VoiceLanguages}" SelectedItem="{Binding SelectedVoiceLanguage}" DisplayMemberPath="Name"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_VoiceLanguageName}" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{x:Static r:Strings.Settings_VoiceLanguageNone}"
                       Visibility="{Binding HasNoVoiceRecogniser, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- One hint for the page -->
          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogHint}" TextWrapping="Wrap" Margin="0,4,0,10"
                     Text="{x:Static r:Strings.Settings_VoiceTabHint}" />
        </Grid>
      </ScrollViewer>

      <!-- ===== General ===== -->
      <ScrollViewer x:Name="GeneralPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabGeneral}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Language -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Language}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_LanguageName}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{x:Static r:Strings.Settings_LanguageHint}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Save and Cancel stay in sight under every tab; the line beside them names the tab with something to fix. -->
    <DockPanel Grid.Row="2" Margin="14,8,14,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{x:Static r:Strings.Common_Save}" Style="{StaticResource DialogButton}" IsDefault="True"
                IsEnabled="{Binding CanSave}" Click="Save_Click" />
        <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
      </StackPanel>
      <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>
