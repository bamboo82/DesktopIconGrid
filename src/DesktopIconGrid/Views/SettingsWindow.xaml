<Window x:Class="DesktopIconGrid.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="490"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="100" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Theme -->
    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Theme:" Margin="0,0,12,10" />
    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
      <Border DockPanel.Dock="Right" Width="26" Height="26" Margin="8,0,0,0"
              Background="{Binding PreviewBrush}"
              BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1" CornerRadius="3"
              ToolTip="Bar background" />
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" VerticalContentAlignment="Center"
                AutomationProperties.Name="Theme">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Border Width="14" Height="14" Margin="0,0,8,0" CornerRadius="2"
                      Background="{Binding Background}"
                      BorderBrush="{Binding Border}" BorderThickness="1" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DockPanel>

    <!-- Custom background -->
    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Background:" Margin="0,0,12,10" VerticalAlignment="Top"
               IsEnabled="{Binding IsCustomTheme}" />
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
      <StackPanel Orientation="Horizontal">
        <TextBox Width="96" Padding="4,3" VerticalContentAlignment="Center"
                 Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Background colour" />
        <TextBlock Text="Use #RRGGBB" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                   Visibility="{Binding IsColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
        <TextBlock Text="Text and highlight colours adapt to the colour." Style="{StaticResource DialogHint}" Margin="10,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding IsColorValid, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Presets}" Margin="0,8,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="24" Height="24" Margin="0,0,6,6" Padding="0"
                    Background="{Binding}"
                    BorderBrush="{DynamicResource SwatchBorderBrush}"
                    ToolTip="{Binding}"
                    AutomationProperties.Name="{Binding}"
                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="3" />
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Bar background (Windows 11 backdrop) -->
    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Bar background:" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
      <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                ItemsSource="{Binding Backdrops}" SelectedItem="{Binding SelectedBackdrop}" DisplayMemberPath="Name"
                IsEnabled="{Binding IsBackdropSupported}"
                AutomationProperties.Name="Bar background" />
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{Binding BackdropHint}" />
    </StackPanel>

    <!-- Icon size -->
    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Icon size:" Margin="0,0,12,10" />
    <ComboBox Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10"
              ItemsSource="{Binding IconSizes}"
              SelectedItem="{Binding IconSize}"
              ItemStringFormat="{}{0} px"
              AutomationProperties.Name="Icon size" />

    <!-- Spacing -->
    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Spacing:" Margin="0,0,12,10" />
    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CellPaddingText}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
      <Slider Minimum="{Binding MinCellPadding}" Maximum="{Binding MaxCellPadding}"
              Value="{Binding CellPadding}"
              IsSnapToTickEnabled="True" TickFrequency="1"
              VerticalAlignment="Center" Margin="0,0,10,0"
              AutomationProperties.Name="Spacing" />
    </DockPanel>

    <!-- Labels -->
    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Labels:" Margin="0,0,12,10" />
    <CheckBox Grid.Row="5" Grid.Column="1" Content="Show names under the icons" IsChecked="{Binding ShowLabels}" Margin="0,0,0,10" VerticalAlignment="Center" />

    <!-- Launch -->
    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Open with:" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
      <RadioButton Content="Single click" GroupName="Launch" IsChecked="{Binding SingleClickToLaunch}" />
      <RadioButton Content="Double click" GroupName="Launch" IsChecked="{Binding DoubleClickToLaunch}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- Window -->
    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Window:" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
      <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
      <CheckBox Content="The close button hides the bar to the tray (Exit is in the tray and options menus)" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0" />
      <CheckBox Content="Windows 11 style dialogs that follow light or dark mode (applies to dialogs opened from now on)" IsChecked="{Binding FluentDialogs}" Margin="0,4,0,0" />
      <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />
      <CheckBox Content="Start hidden: only the tray icon, until the bar is shown from the tray or with the hotkey" IsChecked="{Binding StartHidden}"
                IsEnabled="{Binding StartWithWindows}" Margin="22,4,0,0" />
    </StackPanel>

    <!-- Transparency -->
    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Transparency:" Margin="0,0,12,10" />
    <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Right" Text="{Binding TransparencyText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" />
      <Slider Minimum="0" Maximum="{Binding MaxTransparency}"
              Value="{Binding Transparency}"
              IsSnapToTickEnabled="True" TickFrequency="5"
              VerticalAlignment="Center" Margin="0,0,10,0"
              ToolTip="How much shows through the bar: the desktop with a solid colour, the blurred backdrop with Mica or Acrylic (icons stay sharp)"
              AutomationProperties.Name="Transparency" />
    </DockPanel>

    <!-- Hotkey -->
    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Show/hide hotkey:" Margin="0,0,12,10" VerticalAlignment="Top" />
    <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Clear" Padding="10,3" Margin="8,0,0,0" Click="ClearHotkey_Click"
                IsEnabled="{Binding HasHotkey}" />
        <TextBox x:Name="HotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                 Text="{Binding ToggleHotkey, Mode=OneWay}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 ToolTip="Click here, then press the key combination"
                 AutomationProperties.Name="Show or hide hotkey" />
      </DockPanel>
      <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                 Text="Click the box and press a combination with Ctrl, Alt or Win, e.g. Ctrl+Alt+Space. It shows or hides the bar from any program." />
      <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Save" Style="{StaticResource DialogButton}" IsDefault="True"
              IsEnabled="{Binding CanSave}" Click="Save_Click" />
      <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
