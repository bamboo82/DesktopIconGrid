<Window x:Class="DesktopIconGrid.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        xmlns:views="clr-namespace:DesktopIconGrid.Views"
        Title="{x:Static r:Strings.Settings_Title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="{StaticResource AppIconImage}">
  <!--
    Seven tabs (review 27 B1; Send to PC and Portable since 0.14.0). The tab strip only chooses; the pages lie on top of each other in one cell below it,
    the hidden ones still measured, so the page area is as tall as the tallest page (each at most 560) and the window
    does not jump when the tab changes. On a shorter screen every page scrolls, with Save and Cancel still in sight.
    Each page is its own Grid with exactly the rows it uses.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl x:Name="Tabs" Grid.Row="0" Margin="14,14,14,0" Padding="0" BorderThickness="0,1,0,0"
                SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="{Binding AppearanceTab}" />
      <TabItem Header="{Binding WindowTab}" />
      <TabItem Header="{Binding KeysTab}" />
      <TabItem Header="{Binding VoiceTab}" />
      <TabItem Header="{Binding GeneralTab}" />
      <TabItem Header="{Binding SendToTab}" />
      <TabItem Header="{Binding PortableTab}" />
    </TabControl>

    <Grid x:Name="Pages" Grid.Row="1" Margin="0,12,0,0">

      <!-- ===== Appearance ===== -->
      <ScrollViewer x:Name="AppearancePage" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabAppearance}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Theme -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Theme}" Margin="0,0,12,10" />
          <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <!-- The theme's look: its background, an icon under the pointer and one with the keyboard focus (0.15.0 WP4b) -->
            <Border x:Name="ThemePreview" DockPanel.Dock="Right" Height="30" Margin="8,0,0,0" Padding="2"
                    Background="{Binding PreviewBrush}"
                    BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1" CornerRadius="3"
                    ToolTip="{x:Static r:Strings.Settings_BarBackgroundToolTip}">
              <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="24" CornerRadius="4" BorderThickness="1"
                        Background="{Binding PreviewPointerOverBrush}" BorderBrush="{Binding PreviewPointerOverBorderBrush}"
                        ToolTip="{x:Static r:Strings.Settings_PreviewHover}">
                  <TextBlock Text="A" FontWeight="SemiBold" Foreground="{Binding PreviewForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="24" Height="24" Margin="2,0,0,0" CornerRadius="4" BorderThickness="1.5"
                        BorderBrush="{Binding PreviewFocusBrush}"
                        ToolTip="{x:Static r:Strings.Settings_PreviewFocus}">
                  <TextBlock Text="B" FontWeight="SemiBold" Foreground="{Binding PreviewForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </Border>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" VerticalContentAlignment="Center"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_ThemeName}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" Margin="0,0,8,0" CornerRadius="2"
                            Background="{Binding Background}"
                            BorderBrush="{Binding Border}" BorderThickness="1" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>

          <!-- Custom background -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Background}" Margin="0,0,12,10" VerticalAlignment="Top"
                     IsEnabled="{Binding IsCustomTheme}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <!-- The line beside the box wraps in the width left: in English it ran past the page once the page scrolled (0.14.0 WP2) -->
            <DockPanel>
              <TextBox DockPanel.Dock="Left" Width="96" Padding="4,3" VerticalContentAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_BackgroundColourName}" />
              <!-- The colour picker (0.15.0 WP4); the swatch beside the theme follows it while it is open -->
              <Button x:Name="PickBackgroundButton" DockPanel.Dock="Left" Content="{x:Static r:Strings.Settings_PickColour}" Padding="10,2" Margin="8,0,0,0"
                      VerticalAlignment="Center" Click="PickBackground_Click" />
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static r:Strings.Settings_UseHex}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Visibility="{Binding IsColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Text="{x:Static r:Strings.Settings_ColourHint}" Style="{StaticResource DialogHint}" Margin="0"
                           Visibility="{Binding IsColorValid, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DockPanel>
            <views:ColourSwatches Margin="0,8,0,0" Colours="{Binding Presets}" Command="{Binding SelectPresetCommand}" />

          </StackPanel>

          <!-- The custom theme's hover and focus border colours (0.15.0 WP4b): automatic, from the background, until unticked.
               Rows of the tab's own grid, labels in the label column (review 41 U1); 自動 stays on the line of its box and button
               where it fits and wraps under them where it does not, without the Fluent style's minimum width (as in release
               check V3) that wrapped it in English. -->
          <TextBlock x:Name="HoverColourLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_HoverColour}" Margin="0,0,12,10"
                     IsEnabled="{Binding IsCustomTheme}" />
          <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <Border Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding HoverChipBrush}"
                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1" CornerRadius="3" />
            <TextBox x:Name="HoverColourBox" Width="86" Padding="4,3" VerticalContentAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding HoverColorText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding HoverAutomatic, Converter={StaticResource InverseBool}}"
                     AutomationProperties.Name="{x:Static r:Strings.Settings_HoverColourName}" />
            <Button x:Name="PickHoverButton" Content="{x:Static r:Strings.Settings_PickColour}" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Center"
                    IsEnabled="{Binding HoverAutomatic, Converter={StaticResource InverseBool}}" Click="PickHover_Click" />
            <CheckBox x:Name="HoverAutomaticBox" Content="{x:Static r:Strings.Settings_Automatic}" ContentTemplate="{StaticResource WrappingLabel}" Margin="10,0,0,0" MinWidth="0" VerticalAlignment="Center"
                      IsChecked="{Binding HoverAutomatic}" AutomationProperties.Name="{x:Static r:Strings.Settings_HoverAutomaticName}" />
            <TextBlock Text="{x:Static r:Strings.Settings_UseHex}" Foreground="{DynamicResource WarningBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsHoverColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
          </WrapPanel>

          <Border x:Name="HoverStrengthLabel" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" IsEnabled="{Binding IsCustomTheme}">
            <TextBlock Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_HoverStrengthLabel}" Margin="0"
                       IsEnabled="{Binding HoverAutomatic, Converter={StaticResource InverseBool}}" />
          </Border>
          <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <DockPanel IsEnabled="{Binding HoverAutomatic, Converter={StaticResource InverseBool}}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding HoverStrengthText}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
              <Slider Minimum="{Binding MinHoverStrength}" Maximum="{Binding MaxHoverStrength}" Value="{Binding HoverStrength}"
                      IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Margin="0,0,8,0"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_HoverStrength}" />
            </DockPanel>
          </DockPanel>

          <TextBlock x:Name="FocusColourLabel" Grid.Row="4" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_FocusColour}" Margin="0,0,12,10"
                     IsEnabled="{Binding IsCustomTheme}" />
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <WrapPanel>
              <Border Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding FocusChipBrush}"
                      BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1" CornerRadius="3" />
              <TextBox x:Name="FocusColourBox" Width="86" Padding="4,3" VerticalContentAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding FocusColorText, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding FocusAutomatic, Converter={StaticResource InverseBool}}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_FocusColourName}" />
              <Button x:Name="PickFocusButton" Content="{x:Static r:Strings.Settings_PickColour}" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Center"
                      IsEnabled="{Binding FocusAutomatic, Converter={StaticResource InverseBool}}" Click="PickFocus_Click" />
              <CheckBox x:Name="FocusAutomaticBox" Content="{x:Static r:Strings.Settings_Automatic}" ContentTemplate="{StaticResource WrappingLabel}" Margin="10,0,0,0" MinWidth="0" VerticalAlignment="Center"
                        IsChecked="{Binding FocusAutomatic}" AutomationProperties.Name="{x:Static r:Strings.Settings_FocusAutomaticName}" />
              <TextBlock Text="{x:Static r:Strings.Settings_UseHex}" Foreground="{DynamicResource WarningBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding IsFocusColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
            </WrapPanel>
            <!-- A chosen focus colour too close to the background: a warning, Save still works -->
            <TextBlock x:Name="FocusHardToSeeLine" Margin="0,4,0,0" Text="{x:Static r:Strings.Settings_FocusHardToSee}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Visibility="{Binding IsFocusHardToSee, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- The background picture (0.15.0 WP5): over the colour, under everything else, in the bar and the window at the pointer -->
          <TextBlock x:Name="PictureLabel" Grid.Row="5" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Picture}" Margin="0,0,12,10"
                     VerticalAlignment="Center" IsEnabled="{Binding IsCustomTheme}" />
          <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <!-- The thumbnail is the border's fill, so nothing shares a cell (DialogFitTests) -->
            <Border Width="64" Height="36" Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True"
                    Background="{Binding PictureThumbnailBrush}"
                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1" CornerRadius="3"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_Picture}">
              <TextBlock Text="{x:Static r:Strings.Settings_PictureNone}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding HasPicture, Converter={StaticResource InverseBoolToVisibility}}" />
            </Border>
            <Button x:Name="ChoosePictureButton" Content="{x:Static r:Strings.Settings_ChoosePicture}" Padding="10,2" Margin="0,0,6,0" VerticalAlignment="Center" Click="ChoosePicture_Click" />
            <Button x:Name="PictureFromWebButton" Content="{x:Static r:Strings.Settings_PictureFromWeb}" Padding="10,2" Margin="0,0,6,0" VerticalAlignment="Center" Click="PictureFromWeb_Click" />
            <!-- Where it lies and how far it is zoomed (0.15.0 WP6) -->
            <Button x:Name="AdjustPictureButton" Content="{x:Static r:Strings.Settings_AdjustPicture}" Padding="10,2" Margin="0,0,6,0" VerticalAlignment="Center"
                    IsEnabled="{Binding HasPicture}" Click="AdjustPicture_Click" />
            <Button x:Name="RemovePictureButton" Content="{x:Static r:Strings.Settings_RemovePicture}" Padding="10,2" VerticalAlignment="Center"
                    IsEnabled="{Binding HasPicture}" Click="RemovePicture_Click" />
          </WrapPanel>

          <Border x:Name="PictureStrengthLabel" Grid.Row="6" Grid.Column="0" Margin="0,0,12,10" IsEnabled="{Binding IsCustomTheme}">
            <TextBlock Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_PictureStrengthLabel}" Margin="0"
                       IsEnabled="{Binding HasPicture}" />
          </Border>
          <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" IsEnabled="{Binding IsCustomTheme}">
            <DockPanel IsEnabled="{Binding HasPicture}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding PictureStrengthText}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
              <Slider Minimum="{Binding MinPictureStrength}" Maximum="{Binding MaxPictureStrength}" Value="{Binding PictureStrength}"
                      IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Margin="0,0,8,0"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_PictureStrength}" />
            </DockPanel>
          </DockPanel>

          <!-- Bar background (Windows 11 backdrop) -->
          <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_BarBackground}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Backdrops}" SelectedItem="{Binding SelectedBackdrop}" DisplayMemberPath="Name"
                      IsEnabled="{Binding IsBackdropSupported}"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_BarBackgroundToolTip}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{Binding BackdropHint}" />
          </StackPanel>

          <!-- Background transparency: the background only, icons stay solid (0.14.0); beside the background rows since WP2 -->
          <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Transparency}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding TransparencyText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" />
              <Slider x:Name="TransparencySlider" Minimum="0" Maximum="{Binding MaxTransparency}"
                      Value="{Binding Transparency}"
                      IsSnapToTickEnabled="True" TickFrequency="5"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      ToolTip="{x:Static r:Strings.Settings_TransparencyToolTip}"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_TransparencyName}" />
            </DockPanel>
            <TextBlock x:Name="TransparencyHint" Style="{StaticResource DialogHint}" Margin="0,2,0,0" Text="{x:Static r:Strings.Settings_TransparencyHint}" />
          </StackPanel>

          <!-- Icon size -->
          <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_IconSize}" Margin="0,0,12,10" />
          <!-- A listed size or a typed whole number from 16 to 256 (0.15.0 WP8), read when the box is left or Save is pressed -->
          <ComboBox x:Name="IconSizeBox" Grid.Row="9" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10"
                    IsEditable="True"
                    ItemsSource="{Binding IconSizeChoices}"
                    Text="{Binding IconSizeText, UpdateSourceTrigger=LostFocus}"
                    ToolTip="{x:Static r:Strings.Settings_IconSizeToolTip}"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_IconSizeName}" />

          <!-- Spacing -->
          <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Spacing}" Margin="0,0,12,10" />
          <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CellPaddingText}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider Minimum="{Binding MinCellPadding}" Maximum="{Binding MaxCellPadding}"
                    Value="{Binding CellPadding}"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_SpacingName}" />
          </DockPanel>

          <!-- Labels -->
          <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Labels}" Margin="0,0,12,10" />
          <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Grid.Row="11" Grid.Column="1" Content="{x:Static r:Strings.Settings_ShowLabels}" IsChecked="{Binding ShowLabels}" Margin="0,0,0,10" VerticalAlignment="Center" />

          <!-- Chinese text: Taipei Sans TC Light where this PC has it, else a button that installs it (0.12.0 WP5); for the bar
               and the dialogs alike (0.14.0 WP2) -->
          <TextBlock x:Name="ChineseFontLabel" Grid.Row="12" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_ChineseFont}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,0,0,10">
            <!-- The button goes under the list when the row is too narrow for both (0.12.1, review 28: about 9 px to spare in English) -->
            <WrapPanel x:Name="ChineseFontRow">
              <ComboBox x:Name="ChineseFontList" MinWidth="220" Margin="0,0,8,4" VerticalContentAlignment="Center"
                        ItemsSource="{Binding ChineseFontOptions}" SelectedItem="{Binding SelectedChineseFont}" DisplayMemberPath="Name"
                        AutomationProperties.LabeledBy="{Binding ElementName=ChineseFontLabel}" />
              <Button x:Name="InstallFontButton" Content="{x:Static r:Strings.Settings_ChineseFontInstall}" Padding="10,3" Margin="0,0,0,4"
                      Command="{Binding InstallFontCommand}"
                      Visibility="{Binding IsChineseFontMissing, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock x:Name="ChineseFontHint" Style="{StaticResource DialogHint}" TextWrapping="Wrap" Margin="0,0,0,0"
                       Text="{x:Static r:Strings.Settings_ChineseFontMissing}"
                       Visibility="{Binding ShowsMissingHint, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel x:Name="FontProgress" Margin="0,4,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Cancel}" Padding="10,2" Margin="8,0,0,0" Command="{Binding CancelInstallCommand}" />
              <TextBlock x:Name="FontProgressText" DockPanel.Dock="Right" Text="{Binding InstallProgressText}" VerticalAlignment="Center" Margin="8,0,0,0" />
              <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding InstallProgress, Mode=OneWay}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="FontInstallMessage" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding InstallMessage}"
                       Visibility="{Binding HasInstallMessage, Converter={StaticResource BoolToVisibility}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource DialogHint}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInstallFailed}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="ManualInstall" Margin="0,2,0,0" Visibility="{Binding IsInstallFailed, Converter={StaticResource BoolToVisibility}}">
              <Hyperlink Click="ManualInstall_Click"><Run Text="{x:Static r:Strings.FontInstall_Manual}" /></Hyperlink>
            </TextBlock>
          </StackPanel>

          <!-- Bar text (0.14.0 WP2): the font and the size of the bar's names (0.13.0 WP4), with a sample -->
          <TextBlock x:Name="BarTextHeading" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogLabel}" FontWeight="SemiBold"
                     TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_BarText}" Margin="0,6,0,8" />
          <TextBlock x:Name="UiFontLabel" Grid.Row="14" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_UiFont}" Margin="0,0,12,10" />
          <ComboBox x:Name="UiFontList" Grid.Row="14" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalContentAlignment="Center"
                    ItemsSource="{Binding UiFontOptions}" SelectedItem="{Binding SelectedUiFont}" DisplayMemberPath="Name"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_UiFontName}">
            <ComboBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
          </ComboBox>
          <TextBlock x:Name="TextSizeLabel" Grid.Row="15" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_TextSize}" Margin="0,0,12,10" />
          <ComboBox x:Name="TextSizeList" Grid.Row="15" Grid.Column="1" MinWidth="90" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalContentAlignment="Center"
                    ItemsSource="{Binding TextScaleOptions}" SelectedItem="{Binding SelectedTextScale}" DisplayMemberPath="Name"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TextSizeName}" />
          <TextBlock x:Name="BarSampleLabel" Grid.Row="16" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_TextSample}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="16" Grid.Column="1" Margin="0,0,0,10">
            <!-- In the chosen font and size at once -->
            <TextBlock x:Name="TextSample" Text="{x:Static r:Strings.Settings_BarSample}" FontFamily="{Binding SampleFontFamily}" HorizontalAlignment="Left" Margin="0,0,0,4"
                       TextOptions.TextFormattingMode="{Binding SampleFormatting}">
              <TextBlock.LayoutTransform>
                <ScaleTransform ScaleX="{Binding SampleScale}" ScaleY="{Binding SampleScale}" />
              </TextBlock.LayoutTransform>
            </TextBlock>
            <TextBlock x:Name="BarTextHint" Style="{StaticResource DialogHint}" Margin="0,2,0,0" Text="{x:Static r:Strings.Settings_TextHint}" />
          </StackPanel>

          <!-- Dialog and menu text (0.14.0 WP2): the other windows', the menus' and the tooltips'; the bar's unless chosen -->
          <TextBlock x:Name="DialogTextHeading" Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogLabel}" FontWeight="SemiBold"
                     TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_DialogText}" Margin="0,6,0,8" />
          <TextBlock x:Name="DialogFontLabel" Grid.Row="18" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_UiFont}" Margin="0,0,12,10" />
          <ComboBox x:Name="DialogFontList" Grid.Row="18" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalContentAlignment="Center"
                    ItemsSource="{Binding DialogFontOptions}" SelectedItem="{Binding SelectedDialogFont}" DisplayMemberPath="Name"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_DialogFontName}">
            <ComboBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
          </ComboBox>
          <TextBlock x:Name="DialogTextSizeLabel" Grid.Row="19" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_TextSize}" Margin="0,0,12,10" />
          <ComboBox x:Name="DialogTextSizeList" Grid.Row="19" Grid.Column="1" MinWidth="90" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalContentAlignment="Center"
                    ItemsSource="{Binding DialogScaleOptions}" SelectedItem="{Binding SelectedDialogScale}" DisplayMemberPath="Name"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_DialogTextSizeName}" />
          <TextBlock x:Name="DialogSampleLabel" Grid.Row="20" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_TextSample}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="20" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock x:Name="DialogTextSample" Text="{x:Static r:Strings.Settings_DialogSample}" FontFamily="{Binding DialogSampleFontFamily}" HorizontalAlignment="Left" Margin="0,0,0,4"
                       TextOptions.TextFormattingMode="{Binding DialogSampleFormatting}">
              <TextBlock.LayoutTransform>
                <ScaleTransform ScaleX="{Binding DialogSampleScale}" ScaleY="{Binding DialogSampleScale}" />
              </TextBlock.LayoutTransform>
            </TextBlock>
            <TextBlock x:Name="DialogTextHint" Style="{StaticResource DialogHint}" Margin="0,2,0,0" Text="{x:Static r:Strings.Settings_DialogTextHint}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Window ===== -->
      <ScrollViewer x:Name="WindowPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabWindow}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Launch -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_OpenWith}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <RadioButton ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_SingleClick}" GroupName="Launch" IsChecked="{Binding SingleClickToLaunch}" />
            <RadioButton ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_DoubleClick}" GroupName="Launch" IsChecked="{Binding DoubleClickToLaunch}" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Window -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Window}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Menu_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_CloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_FluentDialogs}" IsChecked="{Binding FluentDialogs}" Margin="0,4,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_StartHidden}" IsChecked="{Binding StartHidden}"
                      IsEnabled="{Binding StartWithWindows}" Margin="22,4,0,0" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="22,4,0,0" Text="{x:Static r:Strings.Settings_StartupDisabledHint}" />
          </StackPanel>

          <!-- Dock to a screen edge -->
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_DockToEdge}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding DockEdges}" SelectedItem="{Binding SelectedDockEdge}" DisplayMemberPath="Name"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_DockToEdgeName}" />
            <CheckBox ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Settings_AutoHide}"
                      IsChecked="{Binding AutoHide}" IsEnabled="{Binding IsDocked}" Margin="0,6,0,0" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_DockHint}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Keys ===== -->
      <ScrollViewer x:Name="KeysPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabKeys}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Show/hide hotkey -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Hotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearHotkey_Click"
                      IsEnabled="{Binding HasHotkey}" />
              <TextBox x:Name="HotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding ToggleHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_HotkeyName}" />
            </DockPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_HotkeyHint}" />
            <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding ToggleHotkeyClash}"
                       Visibility="{Binding HasToggleHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Show-at-pointer hotkey -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_PointerHotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearPointerHotkey_Click"
                      IsEnabled="{Binding HasPointerHotkey}" />
              <TextBox x:Name="PointerHotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding ShowAtPointerHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_PointerHotkeyName}" />
            </DockPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_PointerHotkeyHint}" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Text="{x:Static r:Strings.Settings_PointerHotkeySame}"
                       Visibility="{Binding IsPointerHotkeySame, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="PointerHotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding PointerHotkeyClash}"
                       Visibility="{Binding HasPointerHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Show at pointer while held (0.15.0 WP2): the same box as the two above -->
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_HoldHotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearHoldHotkey_Click"
                      IsEnabled="{Binding HasHoldHotkey}" />
              <TextBox x:Name="HoldHotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding HoldAtPointerHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_HoldHotkeyName}" />
            </DockPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_HoldHotkeyHint}" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Text="{x:Static r:Strings.Settings_HoldHotkeySame}"
                       Visibility="{Binding IsHoldHotkeySame, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="HoldHotkeyHint" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding HoldHotkeyClash}"
                       Visibility="{Binding HasHoldHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Keys in the bar (WindowKeyMap): the table takes the full width -->
          <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_WindowKeys}" Margin="0,4,0,6" />
          <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding WindowKeyRows}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Settings_WindowKeyDefault}" Padding="10,3" Margin="8,0,0,0"
                            Click="WindowKeyDefault_Click" IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBool}}"
                            AutomationProperties.Name="{Binding Label}" />
                    <TextBox DockPanel.Dock="Right" Width="140" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                             Text="{Binding Text, Mode=OneWay}" PreviewKeyDown="WindowKeyBox_PreviewKeyDown"
                             AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_WindowKeysHint}" />
            <TextBlock x:Name="WindowKeyWarning" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Voice ===== -->
      <ScrollViewer x:Name="VoicePage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabVoice}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Voice hotkey -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_VoiceHotkey}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Common_Clear}" Padding="10,3" Margin="8,0,0,0" Click="ClearVoiceHotkey_Click"
                      IsEnabled="{Binding HasVoiceHotkey}" />
              <TextBox x:Name="VoiceHotkeyBox" Padding="4,3" VerticalContentAlignment="Center" IsReadOnly="True" Cursor="Arrow"
                       Text="{Binding VoiceHotkey, Mode=OneWay}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       ToolTip="{x:Static r:Strings.Settings_HotkeyToolTip}"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_VoiceHotkeyName}" />
            </DockPanel>
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{x:Static r:Strings.Settings_VoiceHotkeySame}"
                       Visibility="{Binding IsVoiceHotkeySame, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="VoiceHotkeyWarning" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding VoiceHotkeyClash}"
                       Visibility="{Binding HasVoiceHotkeyClash, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Voice language -->
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_VoiceLanguage}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="260" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding VoiceLanguages}" SelectedItem="{Binding SelectedVoiceLanguage}" DisplayMemberPath="Name"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_VoiceLanguageName}" />
            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{x:Static r:Strings.Settings_VoiceLanguageNone}"
                       Visibility="{Binding HasNoVoiceRecogniser, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- One hint for the page -->
          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogHint}" TextWrapping="Wrap" Margin="0,4,0,10"
                     Text="{x:Static r:Strings.Settings_VoiceTabHint}" />
        </Grid>
      </ScrollViewer>

      <!-- ===== General ===== -->
      <ScrollViewer x:Name="GeneralPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabGeneral}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Language -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_Language}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                      AutomationProperties.Name="{x:Static r:Strings.Settings_LanguageName}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0" Text="{x:Static r:Strings.Settings_LanguageHint}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Send to PC (0.14.0 WP5, A3): this PC's name, receiving, the receive folder, and sync ===== -->
      <ScrollViewer x:Name="SendToPage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabSendTo}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- This PC's name (A3): the one name everywhere; the Sync window shows the same -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_PcName}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <TextBox x:Name="PcNameBox" Text="{Binding PcName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Padding="4,2" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{x:Static r:Strings.Settings_PcName}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,0" Text="{x:Static r:Strings.Settings_PcNameHint}" />
          </StackPanel>

          <!-- Receiving: the same value as the bar menu's item -->
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <CheckBox x:Name="ReceiveFilesBox" ContentTemplate="{StaticResource WrappingLabel}" Content="{x:Static r:Strings.Menu_ReceiveFiles}" IsChecked="{Binding ReceiveFiles}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="22,4,0,0" Text="{x:Static r:Strings.Settings_ReceiveHint}" />
          </StackPanel>

          <!-- The receive folder: Downloads unless another is chosen; this PC's alone -->
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_ReceiveFolder}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel x:Name="ReceiveFolderBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Settings_DataBrowse}" Padding="10,2" Margin="8,0,0,0" Click="BrowseReceiveFolder_Click" />
              <TextBox x:Name="ReceiveFolderBox" Text="{Binding ReceiveFolderText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" VerticalContentAlignment="Center" MinWidth="120"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_ReceiveFolderName}" />
            </DockPanel>
            <TextBlock x:Name="ReceiveFolderErrorText" Text="{Binding ReceiveFolderError}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding HasReceiveFolderError, Converter={StaticResource BoolToVisibility}}" />
            <WrapPanel Margin="0,0,0,2">
              <Button x:Name="ResetReceiveFolderButton" Content="{x:Static r:Strings.Settings_ReceiveFolderReset}" Padding="10,2" Margin="0,0,8,4"
                      IsEnabled="{Binding ReceiveFolderIsDownloads, Converter={StaticResource InverseBool}}" Click="ResetReceiveFolder_Click" />
              <Button Content="{x:Static r:Strings.Settings_DataOpenFolder}" Padding="10,2" Margin="0,0,8,4" Click="OpenReceiveFolder_Click" />
            </WrapPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,2,0,0" Text="{x:Static r:Strings.Settings_ReceiveFolderHint}" />
          </StackPanel>

          <!-- Sync across PCs: how it is set up, and the way to its window -->
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_SyncState}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Menu_Sync}" Padding="10,2" Margin="8,0,0,0" Click="OpenSync_Click" />
              <TextBlock x:Name="SyncStateLine" Text="{Binding SyncStateText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,0" Text="{x:Static r:Strings.Settings_SendToNeedsSync}"
                       Visibility="{Binding NeedsSync, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ===== Portable (0.14.0 WP4): the data location, moved here from General unchanged ===== -->
      <ScrollViewer x:Name="PortablePage" Visibility="Hidden" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                    AutomationProperties.Name="{x:Static r:Strings.Settings_TabPortable}">
        <Grid Margin="14,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Data location (0.13.0 WP1): this PC's folder, or a portable one named in portable.txt; nothing changes before a restart -->
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.Settings_DataLocation}" Margin="0,0,12,10" VerticalAlignment="Top" />
          <StackPanel x:Name="DataLocationBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <RadioButton GroupName="DataLocation" IsChecked="{Binding DataIsThisPc}" Margin="0,0,0,6"
                         Content="{Binding DataThisPcText}" ContentTemplate="{StaticResource WrappingLabel}" />
            <DockPanel Margin="0,0,0,6">
              <RadioButton DockPanel.Dock="Left" GroupName="DataLocation" IsChecked="{Binding DataIsPortable}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Content="{x:Static r:Strings.Settings_DataPortable}" ContentTemplate="{StaticResource WrappingLabel}" />
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Settings_DataBrowse}" Padding="10,2" Margin="8,0,0,0"
                      IsEnabled="{Binding DataIsPortable}" Click="BrowseData_Click" />
              <TextBox x:Name="DataFolderBox" Text="{Binding DataFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataIsPortable}"
                       Padding="4,2" VerticalContentAlignment="Center" MinWidth="120"
                       AutomationProperties.Name="{x:Static r:Strings.Settings_DataFolderName}" />
            </DockPanel>
            <TextBlock x:Name="DataProblemText" Text="{Binding DataProblem}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding HasDataProblem, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Left" Text="{x:Static r:Strings.Settings_DataNow}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Settings_DataOpenFolder}" Padding="10,2" Margin="8,0,0,0" Click="OpenDataFolder_Click" />
              <!-- Read only, and selectable: the path can be copied -->
              <TextBox x:Name="DataNowBox" Text="{Binding DataNow, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.Name="{x:Static r:Strings.Settings_DataNow}" />
            </DockPanel>
            <Button x:Name="ImportThisPcButton" Content="{x:Static r:Strings.Settings_DataImport}" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,4"
                    Click="ImportThisPc_Click" Visibility="{Binding ShowsDataImport, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,0" Text="{x:Static r:Strings.Settings_DataHint}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Save and Cancel stay in sight under every tab; the line beside them names the tab with something to fix. -->
    <DockPanel Grid.Row="2" Margin="14,8,14,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{x:Static r:Strings.Common_Save}" Style="{StaticResource DialogButton}" IsDefault="True"
                IsEnabled="{Binding CanSave}" Click="Save_Click" />
        <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
      </StackPanel>
      <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>
