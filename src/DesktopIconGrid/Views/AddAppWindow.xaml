<Window x:Class="DesktopIconGrid.Views.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.AddApp_Title}"
        Width="560"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource DialogHint}" Margin="0,0,0,8" Text="{x:Static r:Strings.AddApp_Hint}" />

    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBox x:Name="FilterBox" Padding="4,3" VerticalContentAlignment="Center"
               Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{x:Static r:Strings.AddApp_FilterName}" />
      <TextBlock Text="{x:Static r:Strings.AddApp_Filter}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{Binding AddText}" Style="{StaticResource DialogButton}" IsDefault="True" IsEnabled="{Binding CanAdd}" Click="Add_Click" />
        <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Left" Width="80" Height="4" Margin="0,0,8,0" IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <ListBox ItemsSource="{Binding View}" HorizontalContentAlignment="Stretch"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{x:Static r:Strings.AddApp_ListName}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="2">
            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsChosen}" Margin="0,0,8,0"
                      AutomationProperties.Name="{Binding Name}" />
            <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0" Source="{Binding Image}"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource DialogHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
