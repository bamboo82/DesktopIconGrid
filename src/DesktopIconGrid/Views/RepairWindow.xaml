<Window x:Class="DesktopIconGrid.Views.RepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Repair_Title}"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <StackPanel Margin="14">
    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />

    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" Height="160" Margin="0,10,0,0"
             AutomationProperties.Name="{x:Static r:Strings.Repair_ListName}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Reason}" Style="{StaticResource DialogHint}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <DockPanel Margin="0,6,0,0">
      <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Repair_Browse}" Padding="10,3" Margin="8,0,0,0" Click="Browse_Click">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static r:Strings.Props_BrowseFile}" Click="BrowseFile_Click" />
            <MenuItem Header="{x:Static r:Strings.Props_BrowseFolder}" Click="BrowseFolder_Click" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      <ProgressBar DockPanel.Dock="Left" Width="80" Height="4" Margin="0,0,8,0" IsIndeterminate="True"
                   Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <StackPanel Margin="0,12,0,0" Visibility="{Binding CanBeOnlyThisPc, Converter={StaticResource BoolToVisibility}}">
      <RadioButton GroupName="Scope" Content="{x:Static r:Strings.Repair_ThisPcOnly}" IsChecked="{Binding OnlyThisPc}" />
      <RadioButton GroupName="Scope" Content="{x:Static r:Strings.Repair_EveryPc}" Margin="0,4,0,0"
                   IsChecked="{Binding OnlyThisPc, Converter={StaticResource InverseBool}}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{x:Static r:Strings.Repair_Repair}" Style="{StaticResource DialogButton}" IsDefault="True"
              IsEnabled="{Binding CanRepair}" Click="Repair_Click" />
      <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
