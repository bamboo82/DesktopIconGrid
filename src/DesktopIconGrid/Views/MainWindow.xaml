<Window x:Class="DesktopIconGrid.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopIconGrid.Views"
        Title="Desktop Icon Grid"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="120"
        MinHeight="64"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        Icon="{StaticResource AppIconImage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewShortcutCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding NewGroupCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseGroupPopupCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoRemoveCommand}" />
  </Window.InputBindings>

  <Border BorderBrush="{DynamicResource Theme.Border}"
          BorderThickness="1"
          Background="{DynamicResource Theme.BarBackground}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
      </Grid.ColumnDefinitions>

      <!-- Move grip -->
      <Border Grid.Column="0"
              Style="{StaticResource GripStyle}"
              ToolTip="Drag to move the bar. Double-click to toggle always on top."
              AutomationProperties.Name="Move grip"
              MouseLeftButtonDown="Grip_MouseLeftButtonDown" />

      <!-- Icons, with the removal banner under them -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Bottom"
                Visibility="{Binding CanUndoRemove, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource Theme.Hover}"
                BorderBrush="{DynamicResource Theme.HoverBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="2,0,2,2"
                Padding="6,1">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource BarTextButtonStyle}"
                    Content="Undo"
                    ToolTip="Put the removed icon back (Ctrl+Z)"
                    AutomationProperties.Name="Undo remove"
                    Command="{Binding UndoRemoveCommand}" />
            <TextBlock Text="{Binding UndoText}"
                       Foreground="{DynamicResource Theme.Foreground}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <views:IconGridControl x:Name="MainGrid"
                               DataContext="{Binding RootItems}"
                               Margin="0,2" />
      </DockPanel>

      <!-- Close and options -->
      <Grid Grid.Column="2" Margin="0,2,2,2">
        <Button Style="{StaticResource BarButtonStyle}"
                VerticalAlignment="Top"
                ToolTip="{Binding CloseButtonToolTip}"
                AutomationProperties.Name="{Binding CloseButtonToolTip}"
                Click="Close_Click">
          <TextBlock Text="✕" />
        </Button>
        <Button x:Name="OptionsButton"
                Style="{StaticResource BarButtonStyle}"
                VerticalAlignment="Bottom"
                ToolTip="Options"
                AutomationProperties.Name="Options menu"
                Click="Options_Click">
          <TextBlock Text="▸" FontSize="11" />
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+," />
              <MenuItem Header="Sync with Google Drive…" Command="{Binding OpenSyncCommand}" />
              <MenuItem Header="Edit names…" Command="{Binding OpenNameTableCommand}" />
              <MenuItem Header="Log viewer…" Command="{Binding OpenLogViewerCommand}" />
              <MenuItem Header="Launch Multi Launch group" Command="{Binding LaunchMultiLaunchCommand}" />
              <Separator />
              <MenuItem Header="New shortcut…" Command="{Binding NewShortcutCommand}" InputGestureText="Ctrl+N" />
              <MenuItem Header="New group…" Command="{Binding NewGroupCommand}" InputGestureText="Ctrl+G" />
              <Separator />
              <MenuItem Header="Always on top" IsCheckable="True" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
              <MenuItem Header="Open layout file location" Command="{Binding OpenLayoutFolderCommand}" />
              <MenuItem Header="About…" Command="{Binding AboutCommand}" />
              <Separator />
              <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>

      <!-- Group contents -->
      <Popup x:Name="GroupPopup"
             IsOpen="{Binding IsGroupPopupOpen, Mode=TwoWay}"
             StaysOpen="True"
             Placement="Bottom"
             PopupAnimation="Fade"
             AllowsTransparency="False"
             Opened="GroupPopup_Opened">
        <Border Background="{DynamicResource Theme.PopupBackground}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                Padding="3"
                Width="{Binding PopupWidth}"
                MaxHeight="{Binding PopupMaxHeight}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding OpenGroup.Name}"
                       Foreground="{DynamicResource Theme.Foreground}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="4,1,4,3"
                       TextTrimming="CharacterEllipsis" />
            <views:IconGridControl DataContext="{Binding OpenGroup.Children}" />
          </DockPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
