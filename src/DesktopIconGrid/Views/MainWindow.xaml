<Window x:Class="DesktopIconGrid.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        xmlns:views="clr-namespace:DesktopIconGrid.Views"
        Title="{x:Static r:Strings.App_Name}"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="120"
        MinHeight="64"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        Icon="{StaticResource AppIconImage}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.InputBindings>
    <!-- The other keys are the settings' (WindowKeyMap), handled in OnPreviewKeyDown. -->
    <KeyBinding Key="Escape" Command="{Binding CloseGroupPopupCommand}" />
  </Window.InputBindings>

  <Border BorderBrush="{DynamicResource Theme.Border}"
          BorderThickness="1"
          Background="{DynamicResource Theme.BarBackground}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
      </Grid.ColumnDefinitions>

      <!-- Move grip -->
      <Border x:Name="Grip"
              Grid.Column="0"
              Style="{StaticResource GripStyle}"
              ToolTip="{x:Static r:Strings.Main_GripToolTip}"
              AutomationProperties.Name="{x:Static r:Strings.Main_GripName}"
              MouseLeftButtonDown="Grip_MouseLeftButtonDown" />

      <!-- Icons, with the removal banner and the type-to-find box under them -->
      <DockPanel Grid.Column="1">
        <DockPanel x:Name="SearchPanel"
                   DockPanel.Dock="Bottom"
                   Visibility="Collapsed"
                   Margin="2,0,2,2">
          <TextBlock DockPanel.Dock="Right"
                     MaxWidth="160"
                     Style="{StaticResource SearchTargetStyle}"
                     Text="{Binding SelectedSearchResult.Name, StringFormat={}↵ {0}}" />
          <TextBox x:Name="SearchBox"
                   Style="{StaticResource SearchBoxStyle}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{x:Static r:Strings.Main_SearchToolTip}"
                   AutomationProperties.Name="{x:Static r:Strings.Main_SearchName}"
                   PreviewKeyDown="SearchBox_PreviewKeyDown"
                   LostKeyboardFocus="SearchBox_LostKeyboardFocus" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom"
                Visibility="{Binding CanUndoRemove, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource Theme.Hover}"
                BorderBrush="{DynamicResource Theme.HoverBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="2,0,2,2"
                Padding="6,1">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource BarTextButtonStyle}"
                    Content="{x:Static r:Strings.Common_Undo}"
                    ToolTip="{x:Static r:Strings.Main_UndoToolTip}"
                    AutomationProperties.Name="{x:Static r:Strings.Main_UndoName}"
                    Command="{Binding UndoRemoveCommand}" />
            <TextBlock Text="{Binding UndoText}"
                       Foreground="{DynamicResource Theme.Foreground}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <views:IconGridControl x:Name="MainGrid"
                               DataContext="{Binding RootItems}"
                               Margin="0,2" />
      </DockPanel>

      <!-- Close and options -->
      <Grid Grid.Column="2" Margin="0,2,2,2">
        <Button Style="{StaticResource BarButtonStyle}"
                VerticalAlignment="Top"
                ToolTip="{Binding CloseButtonToolTip}"
                AutomationProperties.Name="{Binding CloseButtonToolTip}"
                Click="Close_Click">
          <TextBlock Text="✕" />
        </Button>
        <Button x:Name="OptionsButton"
                Style="{StaticResource BarButtonStyle}"
                VerticalAlignment="Bottom"
                ToolTip="{x:Static r:Strings.Main_Options}"
                AutomationProperties.Name="{x:Static r:Strings.Main_OptionsMenuName}"
                Click="Options_Click">
          <TextBlock Text="▸" FontSize="11" />
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static r:Strings.Menu_Settings}" Command="{Binding OpenSettingsCommand}" InputGestureText="{Binding KeyText[OpenSettings]}" />
              <MenuItem Header="{x:Static r:Strings.Menu_Sync}" Command="{Binding OpenSyncCommand}" />
              <MenuItem Header="{x:Static r:Strings.Menu_EditNames}" Command="{Binding OpenNameTableCommand}" />
              <MenuItem Header="{x:Static r:Strings.Menu_LogViewer}" Command="{Binding OpenLogViewerCommand}" />
              <MenuItem Header="{x:Static r:Strings.Menu_LaunchMultiLaunch}" Command="{Binding LaunchMultiLaunchCommand}" />
              <Separator />
              <MenuItem Header="{x:Static r:Strings.Menu_NewShortcut}" Command="{Binding NewShortcutCommand}" InputGestureText="{Binding KeyText[NewShortcut]}" />
              <MenuItem Header="{x:Static r:Strings.Menu_NewGroup}" Command="{Binding NewGroupCommand}" InputGestureText="{Binding KeyText[NewGroup]}" />
              <Separator />
              <MenuItem Header="{x:Static r:Strings.Menu_AlwaysOnTop}" IsCheckable="True" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
              <MenuItem x:Name="SendToMenuItem" Header="{x:Static r:Strings.Menu_SendTo}" IsCheckable="True" Click="SendTo_Click" />
              <MenuItem Header="{x:Static r:Strings.Menu_RestoreLayout}" Command="{Binding RestoreLayoutCommand}" />
              <MenuItem Header="{x:Static r:Strings.Menu_OpenLayoutLocation}" Command="{Binding OpenLayoutFolderCommand}" />
              <MenuItem Header="{x:Static r:Strings.Menu_About}" Command="{Binding AboutCommand}" />
              <Separator />
              <MenuItem Header="{x:Static r:Strings.Common_Exit}" Command="{Binding ExitCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>

      <!-- Group contents -->
      <Popup x:Name="GroupPopup"
             IsOpen="{Binding IsGroupPopupOpen, Mode=TwoWay}"
             StaysOpen="True"
             Placement="Bottom"
             PopupAnimation="Fade"
             AllowsTransparency="False"
             Opened="GroupPopup_Opened">
        <Border Background="{DynamicResource Theme.PopupBackground}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                Padding="3"
                Width="{Binding PopupWidth}"
                MaxHeight="{Binding PopupMaxHeight}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding OpenGroup.Name}"
                       Foreground="{DynamicResource Theme.Foreground}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="4,1,4,3"
                       TextTrimming="CharacterEllipsis" />
            <views:IconGridControl DataContext="{Binding OpenGroup.Children}" />
          </DockPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
