<Window x:Class="DesktopIconGrid.Views.VoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Voice_Title}"
        MinWidth="280"
        MaxWidth="460"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Closing="Window_Closing">
  <StackPanel Margin="14">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15" />
    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.7" Visibility="Collapsed" />
    <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
    <!-- Review 27, the choice window: each button names the item, says what it is and starts, and warns when the phrase
         came from another PC. The texts are TextBlocks, so an underscore in a name is shown, not taken as an access key.
         No button is the default one. -->
    <ItemsControl x:Name="Choices" Margin="0,10,0,0" Visibility="Collapsed" IsTabStop="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Tag="{Binding}" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="Choice_Click"
                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Detail}">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Detail}" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0" />
              <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                         Visibility="{Binding CameFromAnotherPc, Converter={StaticResource BoolToVisibility}}">
                <Run Text="&#x26A0; " /><Run Text="{x:Static r:Strings.Voice_FromAnotherPc}" />
              </TextBlock>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="CancelButton" Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" HorizontalAlignment="Right"
            Margin="0,10,0,0" Visibility="Collapsed" Click="Cancel_Click" />
    <!-- How long the choices wait: empties over the 20 seconds. -->
    <ProgressBar x:Name="Countdown" Height="3" Minimum="0" Maximum="1" Value="1" Margin="0,10,0,0" Visibility="Collapsed" IsTabStop="False" />
  </StackPanel>
</Window>
