<Window x:Class="DesktopIconGrid.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        FocusManager.FocusedElement="{Binding ElementName=ValueBox}">
  <StackPanel Margin="14">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox x:Name="ValueBox" Padding="4,3" VerticalContentAlignment="Center" />
    <TextBlock x:Name="HintText" Style="{StaticResource DialogHint}" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OkButton" Content="{x:Static r:Strings.Common_OK}" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
      <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
