<Window x:Class="DesktopIconGrid.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Import_Title}"
        Width="600"
        Height="580"
        MinWidth="440"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource DialogHint}" Margin="0,0,0,8" TextWrapping="Wrap" Text="{x:Static r:Strings.Import_Hint}" />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{Binding ImportText}" Style="{StaticResource DialogButton}" IsDefault="True" IsEnabled="{Binding CanImport}" Click="Import_Click" />
        <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Left" Width="80" Height="4" Margin="0,0,8,0" IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="{x:Static r:Strings.Import_GroupPerSource}"
                IsChecked="{Binding GroupPerSource}"
                Visibility="{Binding CanGroup, Converter={StaticResource BoolToVisibility}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{x:Static r:Strings.Import_SelectAll}" Style="{StaticResource DialogButton}" Command="{Binding SelectAllCommand}" />
        <Button Content="{x:Static r:Strings.Import_SelectNone}" Style="{StaticResource DialogButton}" Command="{Binding SelectNoneCommand}" />
      </StackPanel>
    </DockPanel>

    <ListBox x:Name="List" ItemsSource="{Binding View}" HorizontalContentAlignment="Stretch"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{x:Static r:Strings.Import_ListName}">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,0,2" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="2">
            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsChosen}" Margin="0,0,8,0"
                      AutomationProperties.Name="{Binding Name}" />
            <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0" Source="{Binding Image}"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource DialogHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
