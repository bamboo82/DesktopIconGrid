<UserControl x:Class="DesktopIconGrid.Views.IconGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:DesktopIconGrid.Resources"
             xmlns:vm="clr-namespace:DesktopIconGrid.ViewModels"
             xmlns:views="clr-namespace:DesktopIconGrid.Views"
             Focusable="False">
  <UserControl.Resources>
    <!-- An icon: a shortcut, a group or a special icon -->
    <DataTemplate x:Key="IconTemplate" DataType="{x:Type vm:ItemViewModel}">
      <Button Style="{StaticResource IconButtonStyle}"
              ToolTip="{Binding ToolTipText}"
              ToolTipService.InitialShowDelay="350"
              AutomationProperties.Name="{Binding Name}"
              AutomationProperties.HelpText="{Binding HelpText}"
              PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
              PreviewMouseMove="Item_PreviewMouseMove"
              PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
              LostMouseCapture="Item_LostMouseCapture"
              Click="Item_Click"
              MouseDoubleClick="Item_MouseDoubleClick"
              MouseUp="Item_MouseUp"
              PreviewMouseWheel="Item_PreviewMouseWheel"
              MouseLeave="Item_MouseLeave"
              KeyDown="Item_KeyDown">
        <Button.ContextMenu>
          <ContextMenu Opened="ItemMenu_Opened">
            <MenuItem Header="{x:Static r:Strings.Menu_NewShortcut}" Command="{Binding NewShortcutAfterCommand}" />
            <MenuItem Header="{x:Static r:Strings.Menu_NewGroup}" Command="{Binding NewGroupAfterCommand}"
                      Visibility="{Binding IsAtRoot, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Menu_AddApp}" Command="{Binding AddAppAfterCommand}" />
            <MenuItem Header="{x:Static r:Strings.Menu_Import}" Command="{Binding ImportAfterCommand}" />
            <MenuItem Header="{x:Static r:Strings.Menu_AddWindowsItem}" Tag="windows-items" />
            <MenuItem Header="{x:Static r:Strings.Menu_AddSpecialIcon}" Tag="special-icons" />
            <MenuItem Header="{x:Static r:Strings.Menu_AddSeparator}">
              <MenuItem Header="{x:Static r:Strings.Separator_Line}" Tag="line" Click="AddSeparatorAfter_Click" />
              <MenuItem Header="{x:Static r:Strings.Separator_RowHead}" Tag="rowhead" Click="AddSeparatorAfter_Click" />
              <MenuItem Header="{x:Static r:Strings.Separator_RowLine}" Tag="rowline" Click="AddSeparatorAfter_Click" />
              <MenuItem Header="{x:Static r:Strings.Separator_Gap}" Tag="gap" Click="AddSeparatorAfter_Click" />
              <MenuItem Header="{x:Static r:Strings.Separator_Label}" Tag="label" Click="AddSeparatorAfter_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Tag="special-actions-anchor" Visibility="Collapsed" />
            <MenuItem Header="{x:Static r:Strings.Common_Remove}" Command="{Binding RemoveCommand}" InputGestureText="{Binding Root.KeyText[Remove]}" />
            <MenuItem Header="{Binding MultiLaunchMenuHeader}" Command="{Binding ToggleMultiLaunchCommand}"
                      Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Menu_OpenFileLocation}" Command="{Binding OpenLocationCommand}"
                      Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Menu_ShowLog}" Command="{Binding ShowLogCommand}"
                      Visibility="{Binding CapturesLog, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Health_ApproveMenu}" Command="{Binding ApproveHealthCheckCommand}"
                      Visibility="{Binding IsHealthPaused, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Menu_Repair}" Command="{Binding RepairCommand}"
                      Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Menu_Workspaces}" Tag="workspaces"
                      Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Menu_ColorTag}" Tag="color-tags" />
            <Separator />
            <!-- A widget's own text: its look in the text icon window (0.15.0 WP7b) -->
            <MenuItem Header="{x:Static r:Strings.TextLook_Menu}" Click="TextLook_Click"
                      Visibility="{Binding CanEditTextLook, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{x:Static r:Strings.Common_Properties}" Command="{Binding PropertiesCommand}" InputGestureText="{Binding Root.KeyText[Properties]}" />
          </ContextMenu>
        </Button.ContextMenu>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Width="{Binding Root.IconSize}" Height="{Binding Root.IconSize}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="{Binding Image, TargetNullValue={StaticResource PlaceholderIconImage}}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Visibility="{Binding ShowsImage, Converter={StaticResource BoolToVisibility}}" />
            <!-- One drawing of text icons everywhere (0.12.0 WP3): fit, tile colour, a missing symbol -->
            <views:TextIconTile Icon="{Binding DrawnTextIcon}" TileSize="{Binding Root.IconSize}"
                                Visibility="{Binding HasTextIcon, Converter={StaticResource BoolToVisibility}}" />
            <Viewbox Stretch="Uniform" Visibility="{Binding ShowsGauge, Converter={StaticResource BoolToVisibility}}">
              <Grid Width="100" Height="100" DataContext="{Binding Gauge}">
                <Grid.Resources>
                  <!-- Gauge text drawn 20 units high or more is laid out as drawn, smaller text on whole pixels: its size in
                       this box, scaled to the icon (0.15.0 WP9, TextSharpness) -->
                  <Style TargetType="TextBlock">
                    <Setter Property="TextOptions.TextFormattingMode">
                      <Setter.Value>
                        <MultiBinding Converter="{StaticResource ScaledTextFormatting}" ConverterParameter="100">
                          <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                          <Binding Path="DataContext.Root.IconSize" RelativeSource="{RelativeSource AncestorType=Button}" />
                        </MultiBinding>
                      </Setter.Value>
                    </Setter>
                  </Style>
                  <!-- A widget's text look (0.15.0 WP7b, GaugeLook): only what it sets changes; each text keeps its own
                       values as setters, which these triggers win over. The ring's and the bar's value: -->
                  <Style x:Key="GaugeValueLook" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Look.HasFont}" Value="True">
                        <Setter Property="FontFamily" Value="{Binding Look.Family}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Look.HasBold}" Value="True">
                        <Setter Property="FontWeight" Value="{Binding Look.Weight}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Look.HasSize}" Value="True">
                        <Setter Property="FontSize" Value="{Binding LookLabelSize}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Look.HasColor}" Value="True">
                        <Setter Property="Foreground" Value="{Binding Look.TextBrush}" />
                        <Setter Property="Effect" Value="{x:Null}" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Look.EdgesColor}" Value="True" />
                          <Condition Binding="{Binding Look.IsLightText}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeLightTextEdge}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Look.EdgesColor}" Value="True" />
                          <Condition Binding="{Binding Look.IsLightText}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeDarkTextEdge}" />
                      </MultiDataTrigger>
                      <DataTrigger Binding="{Binding Look.HasShift}" Value="True">
                        <Setter Property="RenderTransform" Value="{Binding Look.Shift}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                  <!-- A caption under or over the value takes the font and the colour, not the size, weight or place -->
                  <Style x:Key="GaugeCaptionLook" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Look.HasFont}" Value="True">
                        <Setter Property="FontFamily" Value="{Binding Look.Family}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Look.HasColor}" Value="True">
                        <Setter Property="Foreground" Value="{Binding Look.TextBrush}" />
                        <Setter Property="Effect" Value="{x:Null}" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Look.EdgesColor}" Value="True" />
                          <Condition Binding="{Binding Look.IsLightText}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeLightTextEdge}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Look.EdgesColor}" Value="True" />
                          <Condition Binding="{Binding Look.IsLightText}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeDarkTextEdge}" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Resources>
                <!-- A look's plate is the tile's fill, with a text icon's tile corner (0.15.0 WP7b) -->
                <Border x:Name="GaugePlate" Background="{Binding Look.PlateBrush}" CornerRadius="{Binding Look.PlateCornerRadius, FallbackValue=0}"
                        Visibility="{Binding Look.HasPlate, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                <!-- Ring -->
                <Grid Visibility="{Binding IsRing, Converter={StaticResource BoolToVisibility}}">
                  <Ellipse Width="88" Height="88" Stroke="{DynamicResource Theme.HoverBorder}" StrokeThickness="12" />
                  <Path Data="{Binding ArcGeometry}" Stroke="{Binding LevelBrush}" StrokeThickness="12"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <!-- The gauge's text in the theme's colour takes the bar's edge while it is see-through, in the box's units (review 38 T2) -->
                  <TextBlock x:Name="RingText" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource GaugeValueLook}">
                        <Setter Property="FontSize" Value="26" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeTextEdge}" />
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <!-- Bar -->
                <Grid Visibility="{Binding IsBar, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock x:Name="BarCaption" Text="{Binding Caption}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource GaugeCaptionLook}">
                        <Setter Property="FontSize" Value="24" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeTextEdge}" />
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Height="22" Margin="8,0,8,30" VerticalAlignment="Bottom" CornerRadius="6" ClipToBounds="True"
                          Background="{DynamicResource Theme.HoverBorder}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding FillStar}" />
                        <ColumnDefinition Width="{Binding RemainderStar}" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{Binding LevelBrush}" CornerRadius="6" />
                    </Grid>
                  </Border>
                  <TextBlock x:Name="BarText" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource GaugeValueLook}">
                        <Setter Property="FontSize" Value="22" />
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeTextEdge}" />
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <!-- Number. The caption shows its start (review 27 T1) and is drawn from 40 px icons on; below, the number
                     is centred in the whole height. A value of up to nine characters starts at LabelFontSize and shrinks
                     to fit the width rather than being cut ("100%" is 109 units wide in Segoe UI Bold 42, release check
                     N1); a longer line (a command tile's) is cut at 98 units at its own size, never shrunk (N4). -->
                <Grid Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
                  <Viewbox x:Name="NumberFit" Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="98"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox.Style>
                      <Style TargetType="Viewbox">
                        <Setter Property="Margin" Value="0,-14,0,0" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DataContext.Root.ShowsNumberCaptions, RelativeSource={RelativeSource AncestorType=Viewbox}}" Value="False">
                            <Setter Property="Margin" Value="0" />
                          </DataTrigger>
                          <!-- Up or down in the tile's units, outside the box's own scale (0.15.0 WP7b) -->
                          <DataTrigger Binding="{Binding Look.HasShift}" Value="True">
                            <Setter Property="RenderTransform" Value="{Binding Look.Shift}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Viewbox.Style>
                    <TextBlock x:Name="NumberText" Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding LabelMaxWidth}">
                      <!-- A value in the neutral grey (the clock's time) has an edge of its own; green, orange and red need none.
                           A look's colour is the normal state's: orange and red still win (0.15.0 WP7b). -->
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="FontSize" Value="{Binding LabelFontSize}" />
                          <Setter Property="FontWeight" Value="Bold" />
                          <Setter Property="Foreground" Value="{Binding LevelBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                              <Setter Property="Effect" Value="{DynamicResource Theme.GaugeNeutralEdge}" />
                            </DataTrigger>
                            <!-- Green, orange and red take an edge only over a background picture, where they may lie on any
                                 colour (review 41 U2): the resources are there only then -->
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsNeutral}" Value="False" />
                                <Condition Binding="{Binding IsLightLevel}" Value="True" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Effect" Value="{DynamicResource Theme.GaugeLevelLightEdge}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsNeutral}" Value="False" />
                                <Condition Binding="{Binding IsLightLevel}" Value="False" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Effect" Value="{DynamicResource Theme.GaugeLevelDarkEdge}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Look.HasFont}" Value="True">
                              <Setter Property="FontFamily" Value="{Binding Look.Family}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Look.HasBold}" Value="True">
                              <Setter Property="FontWeight" Value="{Binding Look.Weight}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Look.HasSize}" Value="True">
                              <Setter Property="FontSize" Value="{Binding LookLabelSize}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Look.HasColor}" Value="True" />
                                <Condition Binding="{Binding IsAlarm}" Value="False" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Foreground" Value="{Binding Look.TextBrush}" />
                              <Setter Property="Effect" Value="{x:Null}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Look.EdgesColor}" Value="True" />
                                <Condition Binding="{Binding IsAlarm}" Value="False" />
                                <Condition Binding="{Binding Look.IsLightText}" Value="True" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Effect" Value="{DynamicResource Theme.GaugeLightTextEdge}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Look.EdgesColor}" Value="True" />
                                <Condition Binding="{Binding IsAlarm}" Value="False" />
                                <Condition Binding="{Binding Look.IsLightText}" Value="False" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Effect" Value="{DynamicResource Theme.GaugeDarkTextEdge}" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Viewbox>
                  <TextBlock x:Name="NumberCaption" Text="{Binding Caption}" MaxWidth="96" TextTrimming="CharacterEllipsis"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                             Visibility="{Binding DataContext.Root.ShowsNumberCaptions, RelativeSource={RelativeSource AncestorType=Viewbox}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource GaugeCaptionLook}">
                        <Setter Property="FontSize" Value="22" />
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
                        <Setter Property="Effect" Value="{DynamicResource Theme.GaugeTextEdge}" />
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </Viewbox>
            <Ellipse Width="8" Height="8"
                     Fill="{StaticResource BadgeBrush}"
                     Stroke="#80000000" StrokeThickness="1"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-2,-2"
                     Visibility="{Binding IsMultiLaunch, Converter={StaticResource BoolToVisibility}}" />
            <Ellipse Width="8" Height="8"
                     Fill="{StaticResource RunningBadgeBrush}"
                     Stroke="#80000000" StrokeThickness="1"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-2,0,0,-2"
                     ToolTip="{x:Static r:Strings.Grid_Running}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <!-- Health light (0.9.0) -->
            <Ellipse Width="8" Height="8"
                     Fill="{Binding Health.Brush}"
                     Stroke="#80000000" StrokeThickness="1"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-2,-2,0,0"
                     ToolTip="{Binding Health.Text}"
                     Visibility="{Binding ShowsHealth, Converter={StaticResource BoolToVisibility}}" />
            <!-- Not found on this PC -->
            <Border Width="12" Height="12" CornerRadius="6"
                    Background="{DynamicResource Theme.Accent}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-3,-3,0"
                    ToolTip="{x:Static r:Strings.Grid_Missing}"
                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>

          <TextBlock Grid.Row="1"
                     Text="{Binding Name}"
                     Effect="{DynamicResource Theme.TextEdge}"
                     Foreground="{DynamicResource Theme.Foreground}"
                     FontSize="{Binding Root.NameFontSize}"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Margin="2,1,2,0"
                     Visibility="{Binding Root.ShowLabels, Converter={StaticResource BoolToVisibility}}" />

          <!-- Colour tag -->
          <Path Grid.RowSpan="2"
                Data="M0,0 L9,0 L0,9 Z"
                Fill="{Binding ColorTagBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="2,2,0,0"
                IsHitTestVisible="False"
                Visibility="{Binding HasColorTag, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Button>
    </DataTemplate>

    <!-- A separator: a thin line, an empty cell or a caption -->
    <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type vm:ItemViewModel}">
      <Button Style="{StaticResource SeparatorButtonStyle}"
              AutomationProperties.Name="{Binding SeparatorName}"
              PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
              PreviewMouseMove="Item_PreviewMouseMove"
              PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
              LostMouseCapture="Item_LostMouseCapture"
              PreviewMouseWheel="Item_PreviewMouseWheel"
              MouseLeave="Item_MouseLeave"
              MouseDoubleClick="Separator_MouseDoubleClick"
              KeyDown="Item_KeyDown">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static r:Strings.Separator_Line}" Tag="line" IsChecked="{Binding IsLineSeparator, Mode=OneWay}" Click="SeparatorKind_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_RowHead}" Tag="rowhead" IsChecked="{Binding IsRowHeadSeparator, Mode=OneWay}" Click="SeparatorKind_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_RowLine}" Tag="rowline" IsChecked="{Binding IsRowLineSeparator, Mode=OneWay}" Click="SeparatorKind_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_Gap}" Tag="gap" IsChecked="{Binding IsGapSeparator, Mode=OneWay}" Click="SeparatorKind_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_Label}" Tag="label" IsChecked="{Binding IsLabelSeparator, Mode=OneWay}" Click="SeparatorKind_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_RowLineText}" Click="SeparatorText_Click" InputGestureText="{Binding Root.KeyText[Properties]}"
                      Visibility="{Binding IsRowLineSeparator, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Header="{x:Static r:Strings.Menu_NewShortcut}" Command="{Binding NewShortcutAfterCommand}" />
            <MenuItem Header="{x:Static r:Strings.Common_Remove}" Command="{Binding RemoveCommand}" InputGestureText="{Binding Root.KeyText[Remove]}" />
          </ContextMenu>
        </Button.ContextMenu>
        <Grid>
          <!-- On a see-through background the lines are in the text colour with the names' edge (review 39 T3) -->
          <views:DividerLine Stroke="{DynamicResource Theme.LineStroke}" Effect="{DynamicResource Theme.TextEdge}"
                             Visibility="{Binding ShowsDivider, Converter={StaticResource BoolToVisibility}}" />
          <!-- A row line (0.14.0): its caption, when it has one, then the line to the right edge -->
          <views:RowLinePanel Visibility="{Binding IsRowLineSeparator, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Name}"
                       Effect="{DynamicResource Theme.TextEdge}"
                       Foreground="{DynamicResource Theme.Hint}"
                       FontSize="{Binding Root.NameFontSize}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasPlainRowLineText, Converter={StaticResource BoolToVisibility}}" />
            <!-- The caption with a look of its own (0.15.0 WP7b): what the look leaves out is the caption's as above; a size
                 too large for the room is made smaller, not cut; up or down by a percent of the strip -->
            <Viewbox x:Name="LookedCaption" Stretch="Uniform" StretchDirection="DownOnly"
                     views:RowLinePanel.ShiftPercent="{Binding CaptionLook.OffsetY, FallbackValue=0}"
                     Visibility="{Binding HasLookedRowLineText, Converter={StaticResource BoolToVisibility}}">
              <views:LookedText Text="{Binding Name}" Look="{Binding CaptionLook}"
                                TextElement.Foreground="{DynamicResource Theme.Hint}"
                                TextElement.FontSize="{Binding Root.NameFontSize}"
                                TextElement.FontWeight="SemiBold" />
            </Viewbox>
            <views:DividerLine Stroke="{DynamicResource Theme.LineStroke}" Effect="{DynamicResource Theme.TextEdge}" Inset="0" Flat="True" />
          </views:RowLinePanel>
          <TextBlock Text="{Binding Name}"
                     Effect="{DynamicResource Theme.TextEdge}"
                     Foreground="{DynamicResource Theme.Hint}"
                     FontSize="{Binding Root.NameFontSize}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="5,0"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding IsLabelSeparator, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Button>
    </DataTemplate>

    <views:ItemTemplateSelector x:Key="ItemTemplates"
                                Icon="{StaticResource IconTemplate}"
                                Separator="{StaticResource SeparatorTemplate}" />
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="Scroller"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  AllowDrop="True"
                  DragEnter="Surface_DragOver"
                  DragOver="Surface_DragOver"
                  DragLeave="Surface_DragLeave"
                  Drop="Surface_Drop">
      <ScrollViewer.ContextMenu>
        <ContextMenu Opened="SurfaceMenu_Opened">
          <MenuItem Header="{x:Static r:Strings.Menu_NewShortcut}" Command="{Binding NewShortcutCommand}" />
          <MenuItem Header="{x:Static r:Strings.Menu_NewGroup}" Command="{Binding NewGroupCommand}"
                    Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibility}}" />
          <MenuItem Header="{x:Static r:Strings.Menu_AddApp}" Command="{Binding AddAppCommand}" />
          <MenuItem Header="{x:Static r:Strings.Menu_Import}" Command="{Binding ImportCommand}" />
          <MenuItem Header="{x:Static r:Strings.Menu_AddWindowsItem}" Tag="windows-items" />
          <MenuItem Header="{x:Static r:Strings.Menu_AddSpecialIcon}" Tag="special-icons" />
          <MenuItem Header="{x:Static r:Strings.Menu_AddSeparator}">
            <MenuItem Header="{x:Static r:Strings.Separator_Line}" Tag="line" Click="AddSeparator_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_RowHead}" Tag="rowhead" Click="AddSeparator_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_RowLine}" Tag="rowline" Click="AddSeparator_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_Gap}" Tag="gap" Click="AddSeparator_Click" />
            <MenuItem Header="{x:Static r:Strings.Separator_Label}" Tag="label" Click="AddSeparator_Click" />
          </MenuItem>
          <Separator />
          <MenuItem Header="{x:Static r:Strings.Menu_LaunchMultiLaunch}" Command="{Binding Root.LaunchMultiLaunchCommand}" />
          <MenuItem Header="{x:Static r:Strings.Menu_LockGrid}" IsCheckable="True" IsChecked="{Binding Root.LockGrid, Mode=TwoWay}" />
          <MenuItem Header="{x:Static r:Strings.Menu_Settings}" Command="{Binding Root.OpenSettingsCommand}" />
        </ContextMenu>
      </ScrollViewer.ContextMenu>

      <ItemsControl x:Name="ItemsHost"
                    ItemsSource="{Binding Items}"
                    ItemTemplateSelector="{StaticResource ItemTemplates}"
                    Focusable="False"
                    Margin="1"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabNavigation="Continue">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <views:FlowPanel ItemWidth="{Binding Root.CellWidth}"
                             ItemHeight="{Binding Root.CellHeight}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="views:FlowPanel.Slot" Value="{Binding Slot}" />
            <!-- The tile's name for UI Automation, instead of the view model's type name (release check N3). -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Text="{Binding EmptyHint}"
               Effect="{DynamicResource Theme.TextEdge}"
               Foreground="{DynamicResource Theme.Hint}"
               FontSize="{Binding EmptyHintFontSize}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" TextAlignment="Center"
               Margin="12"
               IsHitTestVisible="False"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="DropIndicator"
              Width="3"
              Background="{DynamicResource Theme.Focus}"
              CornerRadius="1.5"
              Visibility="Collapsed" />
    </Canvas>
  </Grid>
</UserControl>
