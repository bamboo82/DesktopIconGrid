<UserControl x:Class="DesktopIconGrid.Views.IconGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopIconGrid.ViewModels"
             Focusable="False">
  <Grid>
    <ScrollViewer x:Name="Scroller"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  AllowDrop="True"
                  DragEnter="Surface_DragOver"
                  DragOver="Surface_DragOver"
                  DragLeave="Surface_DragLeave"
                  Drop="Surface_Drop">
      <ScrollViewer.ContextMenu>
        <ContextMenu Opened="SurfaceMenu_Opened">
          <MenuItem Header="New shortcut…" Command="{Binding NewShortcutCommand}" />
          <MenuItem Header="New group…" Command="{Binding NewGroupCommand}"
                    Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibility}}" />
          <MenuItem Header="Add Windows item" Tag="windows-items" />
          <Separator />
          <MenuItem Header="Launch Multi Launch group" Command="{Binding Root.LaunchMultiLaunchCommand}" />
          <MenuItem Header="Settings…" Command="{Binding Root.OpenSettingsCommand}" />
        </ContextMenu>
      </ScrollViewer.ContextMenu>

      <ItemsControl x:Name="ItemsHost"
                    ItemsSource="{Binding Items}"
                    Focusable="False"
                    Margin="1"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabNavigation="Cycle">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"
                       ItemWidth="{Binding Root.CellWidth}"
                       ItemHeight="{Binding Root.CellHeight}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <Button Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding ToolTipText}"
                    ToolTipService.InitialShowDelay="500"
                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Item_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
                    Click="Item_Click"
                    MouseDoubleClick="Item_MouseDoubleClick"
                    KeyDown="Item_KeyDown">
              <Button.ContextMenu>
                <ContextMenu Opened="ItemMenu_Opened">
                  <MenuItem Header="New shortcut…" Command="{Binding NewShortcutAfterCommand}" />
                  <MenuItem Header="New group…" Command="{Binding NewGroupAfterCommand}"
                            Visibility="{Binding IsAtRoot, Converter={StaticResource BoolToVisibility}}" />
                  <MenuItem Header="Add Windows item" Tag="windows-items" />
                  <Separator />
                  <MenuItem Header="Remove…" Command="{Binding RemoveCommand}" />
                  <MenuItem Header="{Binding MultiLaunchMenuHeader}" Command="{Binding ToggleMultiLaunchCommand}"
                            Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVisibility}}" />
                  <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}"
                            Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVisibility}}" />
                  <Separator />
                  <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" />
                </ContextMenu>
              </Button.ContextMenu>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="{Binding Root.IconSize}" Height="{Binding Root.IconSize}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Image Source="{Binding Image, TargetNullValue={StaticResource PlaceholderIconImage}}"
                         Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         SnapsToDevicePixels="True" />
                  <Ellipse Width="8" Height="8"
                           Fill="{StaticResource BadgeBrush}"
                           Stroke="#80000000" StrokeThickness="1"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,-2,-2"
                           Visibility="{Binding IsMultiLaunch, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           Foreground="{Binding Root.ForegroundBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,1,2,0"
                           Visibility="{Binding Root.ShowLabels, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Text="{Binding EmptyHint}"
               Foreground="{Binding Root.ForegroundBrush}"
               Opacity="0.65"
               FontSize="12"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" TextAlignment="Center"
               Margin="12"
               IsHitTestVisible="False"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="DropIndicator"
              Width="3"
              Background="{StaticResource AccentBrush}"
              CornerRadius="1.5"
              Visibility="Collapsed" />
    </Canvas>
  </Grid>
</UserControl>
