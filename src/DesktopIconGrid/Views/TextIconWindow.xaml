<Window x:Class="DesktopIconGrid.Views.TextIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        xmlns:views="clr-namespace:DesktopIconGrid.Views"
        Title="{Binding Title}"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        FocusManager.FocusedElement="{Binding ElementName=TextBox}">
  <Grid Margin="14" Grid.IsSharedSizeScope="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Text or Symbol (0.12.0 WP3); a widget has neither, it shows its own text (0.15.0 WP7b) -->
    <StackPanel x:Name="Sides" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10"
                Visibility="{Binding ShowsSides, Converter={StaticResource BoolToVisibility}}">
      <!-- Next to each other: the Fluent style's MinWidth set them 140 px apart (release check V3) -->
      <RadioButton x:Name="TextMode" Content="{x:Static r:Strings.TextIcon_ModeText}" IsChecked="{Binding IsText}" MinWidth="0" Margin="0,0,24,0" />
      <RadioButton x:Name="SymbolMode" Content="{x:Static r:Strings.TextIcon_ModeSymbol}" IsChecked="{Binding IsSymbol}" MinWidth="0" />
    </StackPanel>

    <!-- A widget's two parts (0.16.0 WP4): its value (時間 for the clock) and its name, each a look of its own, one shown at a
         time; switching keeps both. The window's data is the part shown; this choice has the two parts as its own. -->
    <StackPanel x:Name="PartChoice" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed"
                AutomationProperties.Name="{x:Static r:Strings.TextLook_PartsName}">
      <RadioButton x:Name="ValuePart" GroupName="WidgetPart" Content="{Binding ValuePartLabel}" IsChecked="{Binding IsValuePart}" MinWidth="0" Margin="0,0,24,0" />
      <RadioButton x:Name="NamePart" GroupName="WidgetPart" Content="{Binding NamePartLabel}" IsChecked="{Binding IsNamePart}" MinWidth="0" />
    </StackPanel>

    <!-- Preview: the tile as the bar draws it, at the bar's icon size (16 to 64), on the bar's background -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="88" Height="88" Margin="14,0,0,8"
            Background="{DynamicResource Theme.Background}"
            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4"
            VerticalAlignment="Top">
      <Grid>
        <Grid Width="{Binding PreviewSize}" Height="{Binding PreviewSize}"
              Visibility="{Binding IsIconMode, Converter={StaticResource BoolToVisibility}}">
          <!-- The item's real picture under the text, when the text goes over it (0.14.0 WP6) -->
          <Image x:Name="PreviewPicture" Source="{Binding Picture, TargetNullValue={StaticResource PlaceholderIconImage}}"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding ShowsPicture, Converter={StaticResource BoolToVisibility}}" />
          <views:TextIconTile x:Name="Preview" Icon="{Binding PreviewIcon}" TileSize="{Binding PreviewSize}"
                              Width="{Binding PreviewSize}" Height="{Binding PreviewSize}" />
        </Grid>
        <!-- A caption (0.15.0 WP7b): the strip as the bar draws it, the caption and then the line -->
        <views:RowLinePanel x:Name="CaptionPreview" Width="84" VerticalAlignment="Center"
                            Visibility="{Binding IsCaptionMode, Converter={StaticResource BoolToVisibility}}">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                   views:RowLinePanel.ShiftPercent="{Binding OffsetY}">
            <views:LookedText x:Name="CaptionPreviewText" Text="{Binding PreviewText}" Look="{Binding PreviewLook}"
                              TextElement.Foreground="{DynamicResource Theme.Hint}" TextElement.FontSize="{Binding DefaultSize}"
                              TextElement.FontWeight="{Binding DefaultWeight}" TextElement.FontFamily="{Binding DefaultFamily}" />
          </Viewbox>
          <views:DividerLine Stroke="{DynamicResource Theme.LineStroke}" Inset="0" Flat="True" />
        </views:RowLinePanel>
        <!-- A widget's name (0.16.0 WP4): as the bar draws it under the tile, at the bar's name size, made smaller where it is
             too wide, the plate behind it; up or down by its percent of the name's line -->
        <Viewbox x:Name="NamePreview" Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="84" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding IsWidgetNameMode, Converter={StaticResource BoolToVisibility}}">
          <views:LookedText x:Name="NamePreviewText" Text="{Binding PreviewText}" Look="{Binding PreviewLook}" ShiftBase="{Binding NameShiftBase}"
                            TextElement.Foreground="{DynamicResource Theme.Foreground}" TextElement.FontSize="{Binding DefaultSize}"
                            TextElement.FontWeight="{Binding DefaultWeight}" TextElement.FontFamily="{Binding DefaultFamily}" />
        </Viewbox>
        <!-- A widget (0.15.0 WP7b): its text on its tile, in the tile's 100 units, the plate as the tile's fill -->
        <Viewbox x:Name="WidgetPreview" Width="{Binding PreviewSize}" Height="{Binding PreviewSize}"
                 Visibility="{Binding IsWidgetMode, Converter={StaticResource BoolToVisibility}}">
          <Grid Width="100" Height="100">
            <Border Background="{Binding PreviewPlateBrush}" CornerRadius="18.75" />
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="98" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox.RenderTransform>
                <TranslateTransform Y="{Binding OffsetY}" />
              </Viewbox.RenderTransform>
              <views:LookedText x:Name="WidgetPreviewText" Text="{Binding PreviewText}" Look="{Binding PreviewLook}" DrawsPlate="False"
                                TextElement.Foreground="{DynamicResource Theme.Foreground}" TextElement.FontSize="{Binding DefaultSize}"
                                TextElement.FontWeight="{Binding DefaultWeight}" TextElement.FontFamily="{Binding DefaultFamily}" />
            </Viewbox>
          </Grid>
        </Viewbox>
      </Grid>
    </Border>

    <!-- Text: the window as it was -->
    <Grid x:Name="TextFields" Grid.Row="1" Grid.Column="0"
          Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The icon's text, the caption, or what the widget shows now, read-only (0.15.0 WP7b) -->
      <TextBlock x:Name="TextLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{Binding TextLabel}" Margin="0,0,12,8" />
      <TextBox x:Name="TextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogTextBox}"
               MaxLength="{Binding MaxTextLength}" IsReadOnly="{Binding IsTextReadOnly}"
               AutomationProperties.LabeledBy="{Binding ElementName=TextLabel}"
               Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.TextIcon_Font}" Margin="0,0,12,8" />
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                VerticalContentAlignment="Center" MaxDropDownHeight="320">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.TextIcon_Size}" Margin="0,0,12,8" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
        <ComboBox Width="90" IsEditable="True" VerticalContentAlignment="Center"
                  ItemsSource="{Binding FontSizes}"
                  Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="6–72" Style="{StaticResource DialogHint}" Margin="8,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding IsFontSizeValid, Converter={StaticResource InverseBoolToVisibility}}"
                   Foreground="{DynamicResource WarningBrush}" />
        <CheckBox Content="{x:Static r:Strings.Common_Bold}" IsChecked="{Binding Bold}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </StackPanel>
    </Grid>

    <!-- Symbol: a search and the grid -->
    <StackPanel x:Name="SymbolFields" Grid.Row="1" Grid.Column="0"
                Visibility="{Binding IsSymbol, Converter={StaticResource BoolToVisibility}}">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="Label" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SearchLabel" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.TextIcon_Search}" Margin="0,0,12,0" />
        <TextBox x:Name="SearchBox" Grid.Column="1" Padding="4,3" VerticalContentAlignment="Center"
                 AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
      </Grid>
      <Grid>
        <ListBox x:Name="SymbolList" Height="250" Width="460" HorizontalAlignment="Left" Margin="0,0,0,8"
                 ItemsSource="{Binding SymbolsView}" SelectedItem="{Binding SelectedSymbol}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="False">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource DialogHint}" Margin="2,6,0,2" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- 12 cells of 36 x 36 to a row -->
              <WrapPanel Width="432" ItemWidth="36" ItemHeight="36" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="ToolTip" Value="{Binding Name}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Cell" Width="36" Height="36" CornerRadius="4"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                      <TextBlock Text="{Binding Text}" FontSize="20"
                                 FontFamily="{Binding DataContext.SymbolFontFamily, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Cell" Property="Background" Value="#22808080" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <EventSetter Event="MouseDoubleClick" Handler="Symbol_DoubleClick" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock x:Name="NoSymbol" Text="{x:Static r:Strings.TextIcon_NoSymbol}" Style="{StaticResource DialogHint}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False"
                   Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </StackPanel>

    <!-- Up or down, colour and tile colour, on both sides -->
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 垂直位移 (0.15.0 WP7a): up or down a little, for text and symbols alike; the preview follows at once -->
      <TextBlock x:Name="OffsetLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.TextIcon_Offset}" Margin="0,0,12,8" />
      <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
        <Button x:Name="ResetOffsetButton" DockPanel.Dock="Right" Content="{x:Static r:Strings.TextIcon_OffsetReset}" Padding="10,2" Margin="8,0,0,0"
                VerticalAlignment="Center" Click="ResetOffset_Click" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding OffsetText}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
        <Slider x:Name="OffsetSlider" Minimum="{Binding MinOffsetY}" Maximum="{Binding MaxOffsetY}" Value="{Binding OffsetY}"
                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5" VerticalAlignment="Center" Margin="0,0,8,0"
                AutomationProperties.LabeledBy="{Binding ElementName=OffsetLabel}" ToolTip="{x:Static r:Strings.TextIcon_OffsetToolTip}" />
      </DockPanel>

      <TextBlock x:Name="ColourLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{x:Static r:Strings.TextIcon_Colour}" Margin="0,0,12,8" />
      <!-- The hint wraps in the width the box and the picker's button leave (0.15.0 WP4) -->
      <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
        <TextBox x:Name="ColourBox" DockPanel.Dock="Left" Width="110" Padding="4,3" VerticalContentAlignment="Center" VerticalAlignment="Center"
                 AutomationProperties.LabeledBy="{Binding ElementName=ColourLabel}"
                 Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
        <!-- The colour picker (0.15.0 WP4); the preview follows it while it is open -->
        <Button x:Name="PickColourButton" DockPanel.Dock="Left" Content="{x:Static r:Strings.Settings_PickColour}" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
                Click="PickColour_Click" />
        <TextBlock x:Name="ColourHint" Text="{x:Static r:Strings.TextIcon_ColourHint}" Style="{StaticResource DialogHint}" TextWrapping="Wrap"
                   Margin="8,0,0,0" VerticalAlignment="Center" />
      </DockPanel>

      <TextBlock x:Name="TileColourLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="{Binding TileColorLabel}"
                 VerticalAlignment="Top" Margin="0,4,12,0" />
      <!-- The swatches on the row, the code, None and the warning under them: on one line they did not fit (release check V3) -->
      <StackPanel Grid.Row="2" Grid.Column="1">
        <views:ColourSwatches x:Name="TileSwatches" Colours="{Binding TileColors}" Selected="{Binding TileColor}"
                              Command="{Binding SelectTileColorCommand}" Margin="0,2,0,0" />
        <StackPanel x:Name="TileColourCode" Orientation="Horizontal" Margin="0,2,0,0">
          <TextBox x:Name="TileColourBox" Width="110" Padding="4,3" VerticalContentAlignment="Center"
                   AutomationProperties.LabeledBy="{Binding ElementName=TileColourLabel}"
                   Text="{Binding TileColor, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Name="PickTileColourButton" Content="{x:Static r:Strings.Settings_PickColour}" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
                  Click="PickTileColour_Click" />
          <Button Content="{x:Static r:Strings.TextIcon_TileColourNone}" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
                  Command="{Binding ClearTileColorCommand}" />
          <TextBlock Text="{x:Static r:Strings.Settings_UseHex}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                     Visibility="{Binding IsTileColorValid, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogHint}" Margin="0,2,0,8" TextWrapping="Wrap"
                 Text="{x:Static r:Strings.TextIcon_TileColourHint}" />
    </Grid>

    <!-- Keep the item's picture and put the text over it, on both sides (0.14.0 WP6) -->
    <StackPanel x:Name="OverImageBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                Visibility="{Binding CanOverImage, Converter={StaticResource BoolToVisibility}}">
      <CheckBox x:Name="OverImageBox" Content="{x:Static r:Strings.TextIcon_OverImage}" ContentTemplate="{StaticResource WrappingLabel}"
                IsChecked="{Binding OverImage}" />
      <WrapPanel x:Name="PlaceChoices" Margin="22,6,0,0" IsEnabled="{Binding OverImage}">
        <TextBlock Text="{x:Static r:Strings.TextIcon_Place}" VerticalAlignment="Center" Margin="0,0,10,4" />
        <RadioButton GroupName="Place" Content="{x:Static r:Strings.TextIcon_PlaceCenter}" IsChecked="{Binding IsPlaceCenter}" MinWidth="0" Margin="0,0,14,4" />
        <RadioButton GroupName="Place" Content="{x:Static r:Strings.TextIcon_PlaceTopLeft}" IsChecked="{Binding IsPlaceTopLeft}" MinWidth="0" Margin="0,0,14,4" />
        <RadioButton GroupName="Place" Content="{x:Static r:Strings.TextIcon_PlaceTopRight}" IsChecked="{Binding IsPlaceTopRight}" MinWidth="0" Margin="0,0,14,4" />
        <RadioButton GroupName="Place" Content="{x:Static r:Strings.TextIcon_PlaceBottomLeft}" IsChecked="{Binding IsPlaceBottomLeft}" MinWidth="0" Margin="0,0,14,4" />
        <RadioButton GroupName="Place" Content="{x:Static r:Strings.TextIcon_PlaceBottomRight}" IsChecked="{Binding IsPlaceBottomRight}" MinWidth="0" Margin="0,0,0,4" />
      </WrapPanel>
    </StackPanel>
    <TextBlock x:Name="HintLine" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogHint}" Margin="0,4,0,8"
               TextWrapping="Wrap" Text="{Binding Hint}"
               Visibility="{Binding ShowsHint, Converter={StaticResource BoolToVisibility}}" />

    <!-- Buttons -->
    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button x:Name="OkButton" Content="{x:Static r:Strings.Common_OK}" Style="{StaticResource DialogButton}" IsDefault="True"
              IsEnabled="{Binding CanSave}" Click="Ok_Click" />
      <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
