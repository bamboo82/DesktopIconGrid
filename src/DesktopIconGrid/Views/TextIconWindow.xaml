<Window x:Class="DesktopIconGrid.Views.TextIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text icon"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        FocusManager.FocusedElement="{Binding ElementName=TextBox}">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="70" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Preview, spanning the rows on the right -->
    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Width="88" Height="88" Margin="14,0,0,8"
            Background="{DynamicResource Theme.Background}"
            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4"
            VerticalAlignment="Top">
      <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True"
              Background="{DynamicResource Theme.Hover}"
              BorderBrush="{DynamicResource Theme.HoverBorder}" BorderThickness="1">
        <TextBlock Text="{Binding PreviewText}"
                   FontFamily="{Binding PreviewFontFamily}"
                   FontSize="{Binding PreviewFontSize}"
                   FontWeight="{Binding PreviewFontWeight}"
                   Foreground="{Binding PreviewBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2" />
      </Border>
    </Border>

    <!-- Text -->
    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Text:" Margin="0,0,12,8" />
    <TextBox x:Name="TextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogTextBox}"
             MaxLength="{Binding MaxTextLength}"
             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

    <!-- Font -->
    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Font:" Margin="0,0,12,8" />
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
              ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
              VerticalContentAlignment="Center" MaxDropDownHeight="320">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- Size and weight -->
    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Size:" Margin="0,0,12,8" />
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
      <ComboBox Width="90" IsEditable="True" VerticalContentAlignment="Center"
                ItemsSource="{Binding FontSizes}"
                Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="6–72" Style="{StaticResource DialogHint}" Margin="8,0,0,0" VerticalAlignment="Center"
                 Visibility="{Binding IsFontSizeValid, Converter={StaticResource InverseBoolToVisibility}}"
                 Foreground="{DynamicResource WarningBrush}" />
      <CheckBox Content="Bold" IsChecked="{Binding Bold}" VerticalAlignment="Center" Margin="16,0,0,0" />
    </StackPanel>

    <!-- Colour -->
    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Colour:" Margin="0,0,12,8" />
    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBox Width="96" Padding="4,3" VerticalContentAlignment="Center"
               Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Text="#RRGGBB, or empty for the theme's text colour" Style="{StaticResource DialogHint}"
                 Margin="8,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DialogHint}" Margin="0,4,0,8"
               Text="The text is drawn on a tile in place of the icon image. Short labels or one to four characters work best." />

    <!-- Buttons -->
    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="OK" Style="{StaticResource DialogButton}" IsDefault="True"
              IsEnabled="{Binding CanSave}" Click="Ok_Click" />
      <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
