<UserControl x:Class="DesktopIconGrid.Views.ColourSwatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopIconGrid.Views"
             IsTabStop="False">
  <!-- The colour swatches of Settings > Appearance, also the tile colours of a text icon (0.12.0 WP3) -->
  <ItemsControl x:Name="Swatches" IsTabStop="False"
                ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=views:ColourSwatches}}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Button Width="24" Height="24" Margin="0,0,6,6" Padding="0"
                Background="{Binding Color}"
                BorderBrush="{DynamicResource SwatchBorderBrush}"
                ToolTip="{Binding Color}"
                AutomationProperties.Name="{Binding Color}"
                Command="{Binding Command, RelativeSource={RelativeSource AncestorType=views:ColourSwatches}}"
                CommandParameter="{Binding Color}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Swatch" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="3" />
              <ControlTemplate.Triggers>
                <!-- The colour in use (release check V3): a ring in the accent colour -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                  <Setter TargetName="Swatch" Property="BorderThickness" Value="3" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
