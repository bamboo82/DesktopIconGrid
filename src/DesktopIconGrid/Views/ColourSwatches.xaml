<UserControl x:Class="DesktopIconGrid.Views.ColourSwatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopIconGrid.Views"
             IsTabStop="False">
  <!-- The colour swatches of Settings > Appearance, also the tile colours of a text icon (0.12.0 WP3) -->
  <ItemsControl x:Name="Swatches" IsTabStop="False"
                ItemsSource="{Binding Colours, RelativeSource={RelativeSource AncestorType=views:ColourSwatches}}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Button Width="24" Height="24" Margin="0,0,6,6" Padding="0"
                Background="{Binding}"
                BorderBrush="{DynamicResource SwatchBorderBrush}"
                ToolTip="{Binding}"
                AutomationProperties.Name="{Binding}"
                Command="{Binding Command, RelativeSource={RelativeSource AncestorType=views:ColourSwatches}}"
                CommandParameter="{Binding}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="3" />
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
