<Window x:Class="DesktopIconGrid.Views.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        Closing="Window_Closing">
  <StackPanel Margin="14">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
    <ProgressBar IsIndeterminate="True" Height="14" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
