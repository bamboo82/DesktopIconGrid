<Window x:Class="DesktopIconGrid.Views.PicturePositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        Title="{x:Static r:Strings.Position_Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{StaticResource AppIconImage}"
        FocusManager.FocusedElement="{Binding ElementName=Preview}">
  <!-- 調整位置… (0.15.0 WP6): what part of the picture the bar shows, and how far it is zoomed -->
  <StackPanel Margin="14">
    <TextBlock Text="{x:Static r:Strings.Position_Hint}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,8" />

    <!-- The whole picture, dimmed but for what the bar shows, with a cross at the focus point -->
    <Grid x:Name="Preview" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" HorizontalAlignment="Left"
          Focusable="True" Cursor="SizeAll" ClipToBounds="True"
          MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp"
          MouseWheel="Preview_MouseWheel" KeyDown="Preview_KeyDown"
          AutomationProperties.Name="{x:Static r:Strings.Position_PictureName}"
          AutomationProperties.HelpText="{x:Static r:Strings.Position_Hint}">
      <Image x:Name="PictureImage" Stretch="Fill" />
      <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />
      <Canvas IsHitTestVisible="False">
        <Rectangle x:Name="FrameOuter" Stroke="#FF000000" StrokeThickness="1" />
        <Rectangle x:Name="FrameInner" Stroke="#FFFFFFFF" StrokeThickness="2" />
        <Path x:Name="CrossMark" Stroke="#FFFFFFFF" StrokeThickness="1.5" />
      </Canvas>
    </Grid>

    <DockPanel Margin="0,10,0,0">
      <TextBlock DockPanel.Dock="Left" Text="{x:Static r:Strings.Position_Zoom}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomText}" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" />
      <Slider Minimum="{Binding MinZoom}" Maximum="{Binding MaxZoom}" Value="{Binding Zoom}" IsSnapToTickEnabled="True" TickFrequency="10"
              VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="{x:Static r:Strings.Position_Zoom}" />
    </DockPanel>

    <!-- The bar's look at its proportions, with the picture as fitted, at the strength and transparency Settings has -->
    <TextBlock Text="{x:Static r:Strings.Position_StripLabel}" Margin="0,10,0,4" />
    <Border x:Name="Strip" HorizontalAlignment="Left" BorderThickness="1" ClipToBounds="True"
            AutomationProperties.Name="{x:Static r:Strings.Position_StripLabel}">
      <Grid>
        <Rectangle x:Name="StripColour" />
        <Rectangle x:Name="StripPicture" />
        <StackPanel x:Name="StripIcons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,2" />
      </Grid>
    </Border>

    <DockPanel Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="{x:Static r:Strings.Position_Centre}" Padding="12,2" Click="Centre_Click" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{x:Static r:Strings.Common_OK}" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
        <Button Content="{x:Static r:Strings.Common_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
