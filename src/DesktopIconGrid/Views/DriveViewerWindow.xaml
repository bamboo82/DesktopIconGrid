<Window x:Class="DesktopIconGrid.Views.DriveViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="520"
        MinWidth="480"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Icon="{StaticResource AppIconImage}"
        Loaded="Window_Loaded">
  <DockPanel>
    <!-- Toolbar -->
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Refresh" Padding="10,3" Command="{Binding RefreshCommand}" />
        <Button Content="Download to…" Padding="10,3" Margin="6,0,0,0" Click="DownloadTo_Click"
                ToolTip="Copy the selected items to a folder on this PC" />
        <Button Content="Open in browser" Padding="10,3" Margin="6,0,0,0" Command="{Binding OpenInBrowserCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="◀ Back" Padding="8,3" Command="{Binding BackCommand}" />
        <Button Content="▲ Up" Padding="8,3" Margin="6,0,10,0" Command="{Binding UpCommand}" />
        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="›" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource DialogHintBrush}" />
                <Button Content="{Binding Name}" Padding="6,2" BorderThickness="0" Background="Transparent" Cursor="Hand"
                        Click="Crumb_Click" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>

    <!-- Status bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
      <Button DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Margin="8,0,0,0" Command="{Binding CancelCommand}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" Margin="8,0,0,0" Minimum="0" Maximum="100"
                   Value="{Binding TransferPercent, Mode=OneWay, TargetNullValue=0}"
                   Visibility="{Binding HasTransferPercent, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="8,0,8,2" Style="{StaticResource DialogHint}"
               Text="Double-click to open • Drag items to the desktop or a folder to copy them to this PC • Drop files here to upload" />

    <!-- Files -->
    <ListView x:Name="FileList"
              Margin="8,0"
              ItemsSource="{Binding Entries}"
              SelectionMode="Extended"
              AllowDrop="True"
              Drop="FileList_Drop"
              DragOver="FileList_DragOver"
              PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
              PreviewMouseMove="FileList_PreviewMouseMove"
              MouseDoubleClick="FileList_MouseDoubleClick"
              KeyDown="FileList_KeyDown">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Name" Width="340">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon, TargetNullValue={StaticResource PlaceholderIconImage}}" Width="16" Height="16" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding KindText}" />
          <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
          <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding ModifiedText}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
