<Window x:Class="DesktopIconGrid.Views.PointerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DesktopIconGrid.Resources"
        xmlns:views="clr-namespace:DesktopIconGrid.Views"
        Title="{x:Static r:Strings.App_Name}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True">

  <!-- The bar's frame, without its resize border (0.15.0 WP3): a backdrop or a see-through background paint behind it. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <!-- The bar's background and border (0.15.0 WP3; BarSurface makes the window behind it a backdrop or see-through) -->
  <Border x:Name="Chrome" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
          Background="{DynamicResource Theme.BarBackground}">
    <Grid x:Name="ChromeContent">
    <!-- The custom theme's background picture, as on the bar (0.15.0 WP5): it covers the inside of the border, so the
         space around the content is a margin, not the border's padding -->
    <Rectangle x:Name="PictureLayer" IsHitTestVisible="False" Visibility="Collapsed" />
    <DockPanel Margin="3">
      <!-- Search box with its placeholder, and what Enter opens. Not in the window shown while a key is held (0.16.0
           WP1): collapsed then, with the gap under it, so what follows sits directly at the top. Each row above the icons
           keeps its gap under it, so the tap form is laid out as before. -->
      <DockPanel x:Name="SearchRow" DockPanel.Dock="Top" Margin="0,0,0,3">
        <TextBlock DockPanel.Dock="Right"
                   MaxWidth="140"
                   Style="{StaticResource SearchTargetStyle}"
                   Text="{Binding SelectedSearchResult.Name, StringFormat={}↵ {0}}" />
        <Grid>
          <!-- No tooltip: the window opens with the pointer on this box, so it would cover the first row every time. -->
          <!-- A solid fill of its own, so typed text reads on a see-through background (0.15.0 WP3) -->
          <TextBox x:Name="SearchBox"
                   Style="{StaticResource SearchBoxStyle}"
                   Background="{DynamicResource Theme.Background}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{x:Static r:Strings.Main_SearchName}"
                   AutomationProperties.HelpText="{x:Static r:Strings.Main_SearchToolTip}" />
          <TextBlock Text="{x:Static r:Strings.Pointer_Placeholder}"
                     Foreground="{DynamicResource Theme.Hint}"
                     FontSize="12"
                     Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>

      <!-- An open group: back and its name -->
      <DockPanel x:Name="GroupHeader" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,3">
        <Button Style="{StaticResource BarButtonStyle}"
                Width="22"
                Click="Back_Click"
                ToolTip="{x:Static r:Strings.Pointer_BackToolTip}"
                AutomationProperties.Name="{x:Static r:Strings.Pointer_BackName}">
          <TextBlock Text="←" FontSize="12" Style="{StaticResource BarGlyphStyle}" />
        </Button>
        <TextBlock x:Name="GroupTitle"
                   Effect="{DynamicResource Theme.TextEdge}"
                   Foreground="{DynamicResource Theme.Foreground}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="6,0,4,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- The bar's notice line (0.15.0 WP1: the grid is locked) under the icons, as wide as they are; the window grows by it -->
      <Border x:Name="MessageRow"
              DockPanel.Dock="Bottom"
              Visibility="Collapsed"
              HorizontalAlignment="Left"
              Background="{DynamicResource Theme.Hover}"
              BorderBrush="{DynamicResource Theme.HoverBorder}"
              BorderThickness="1"
              CornerRadius="4"
              Margin="0,3,0,0"
              Padding="6,1">
        <TextBlock x:Name="MessageText"
                   Foreground="{DynamicResource Theme.Foreground}"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </Border>

      <!-- The bar's icon area, its size set from the bar's (0.15.0 WP3). In the window shown while a key is held it takes
           the keyboard focus itself, without a frame (0.16.0 WP1; PointerWindow.FocusStart) -->
      <views:IconGridControl x:Name="Icons" OpensGroupsInPlace="True" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </DockPanel>
    </Grid>
  </Border>
</Window>
