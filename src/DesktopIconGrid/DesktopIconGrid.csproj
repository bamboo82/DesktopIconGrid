<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DesktopIconGrid</RootNamespace>
    <AssemblyName>DesktopIconGrid</AssemblyName>
    <AssemblyTitle>Desktop Icon Grid</AssemblyTitle>
    <Description>A compact launcher bar that shows programs, folders and links as a grid of icons.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RollForward>LatestMinor</RollForward>
    <!-- WPF0001: ThemeMode (Fluent theme) is still marked experimental in the reference assemblies. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DesktopIconGrid.Core/DesktopIconGrid.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's only package (the owner's decision, 2026-11-12): Microsoft's wrapper over Windows' desktop speech
         recognisers, for voice launch. The trial in FEATURES §6.1 showed the newer WinRT recogniser cannot be created
         on the owner's PC, and this one hears the names. -->
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopIconGrid.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text. Translations live in Strings.zh-Hant.resx / .zh-Hans.resx; XAML reads the keys through x:Static r:Strings.*.
         Visual Studio regenerates Strings.Designer.cs when the .resx is saved (the WPF markup compiler cannot use a class generated during the build). -->
    <EmbeddedResource Update="Resources/Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources/Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
