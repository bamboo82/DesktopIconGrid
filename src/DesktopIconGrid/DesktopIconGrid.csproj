<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DesktopIconGrid</RootNamespace>
    <AssemblyName>DesktopIconGrid</AssemblyName>
    <AssemblyTitle>Desktop Icon Grid</AssemblyTitle>
    <Description>A compact launcher bar that shows programs, folders and links as a grid of icons.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RollForward>LatestMinor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DesktopIconGrid.Core/DesktopIconGrid.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI, used to encrypt the stored Google sign-in token for the current Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
