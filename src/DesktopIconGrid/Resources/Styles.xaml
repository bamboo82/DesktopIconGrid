<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DesktopIconGrid.Converters">

  <!-- Converters -->
  <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:InverseBooleanConverter x:Key="InverseBool" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:ScaledTextFormattingConverter x:Key="ScaledTextFormatting" />
  <conv:NameLookWidthConverter x:Key="NameLookWidth" />
  <conv:LineHeightConverter x:Key="LineHeight" />

  <!-- Consolas text; UiFonts puts the Chinese font after Consolas when there is one (0.12.1, review 28 F2) -->
  <FontFamily x:Key="App.CodeFontFamily">Consolas, Courier New</FontFamily>
  <FontFamily x:Key="App.LogFontFamily">Consolas, Segoe UI</FontFamily>

  <!--
    Theme brushes. These defaults are the "Classic" palette; ThemeManager replaces them at runtime
    and everything that uses them with DynamicResource follows.
  -->
  <SolidColorBrush x:Key="Theme.Background" Color="#FF73806E" />
  <SolidColorBrush x:Key="Theme.BarBackground" Color="#FF73806E" />
  <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FF73806E" />
  <SolidColorBrush x:Key="Theme.Border" Color="#FF333333" />
  <SolidColorBrush x:Key="Theme.Foreground" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Theme.Hint" Color="#FFFFFFFF" Opacity="0.65" />
  <SolidColorBrush x:Key="Theme.Hover" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="Theme.HoverBorder" Color="#50FFFFFF" />
  <SolidColorBrush x:Key="Theme.LineStroke" Color="#50FFFFFF" />
  <SolidColorBrush x:Key="Theme.Pressed" Color="#50FFFFFF" />
  <SolidColorBrush x:Key="Theme.Grip" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="Theme.Accent" Color="#FF4C8BF5" />
  <SolidColorBrush x:Key="Theme.DropTarget" Color="#4A4C8BF5" />
  <!-- Under the pointer and on keyboard focus (0.15.0 WP4b): the custom theme's own colours when it has them -->
  <SolidColorBrush x:Key="Theme.PointerOver" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="Theme.PointerOverBorder" Color="#50FFFFFF" />
  <SolidColorBrush x:Key="Theme.Focus" Color="#FF4C8BF5" />
  <DrawingBrush x:Key="Theme.GripPattern" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="#70FFFFFF">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="2,2" RadiusX="1" RadiusY="1" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Badge brushes sit on the bar and stay fixed; the dialog brushes are recoloured by DialogTheme for dark mode.
       DialogHintBrush stays grey where grey says something: the log's Debug lines (their level) and the Drive viewer's
       path dividers (not text). -->
  <SolidColorBrush x:Key="BadgeBrush" Color="#FFF5A623" />
  <SolidColorBrush x:Key="RunningBadgeBrush" Color="#FF34C759" />
  <SolidColorBrush x:Key="DialogHintBrush" Color="#FF6E6E6E" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFB55A00" />
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFC62828" />
  <SolidColorBrush x:Key="SwatchBorderBrush" Color="#FF9A9A9A" />

  <!-- The program's icon (0.14.0 WP7): the frames of assets/icons/app.ico, built in as a resource. A window's title bar
       and Alt+Tab take the frame of their size from it; until 0.14.0 this was a drawing of the same four tiles. -->
  <ImageSource x:Key="AppIconImage">pack://application:,,,/DesktopIconGrid;component/Resources/app.ico</ImageSource>

  <!-- Google Drive Bucket: a folder with the three-colour Drive triangle -->
  <DrawingImage x:Key="DriveBucketIconImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFE0A82E">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M2,6 L2,27 A2,2 0 0 0 4,29 L28,29 A2,2 0 0 0 30,27 L30,9 A2,2 0 0 0 28,7 L15,7 L12,4 L4,4 A2,2 0 0 0 2,6 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFF4C64F">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M2,11 L30,11 L30,27 A2,2 0 0 1 28,29 L4,29 A2,2 0 0 1 2,27 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FF1FA463">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M13,14 L19,14 L13,24 L10,19 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFFFC107">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M19,14 L22,19 L16,24 L13,24 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FF4285F4">
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M10,19 L22,19 L19.5,23 L12.5,23 Z" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Sound Replayer: a microphone -->
  <DrawingImage x:Key="SoundReplayerIconImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FF3B3B3B">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="11,2,10,17" RadiusX="5" RadiusY="5" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFE5484D">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="13,4,6,8" RadiusX="3" RadiusY="3" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FF3B3B3B" Thickness="2.2" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M7,13 A9,9 0 0 0 25,13 M16,22 L16,27 M11,28 L21,28" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Placeholder shown while an icon loads or when none can be resolved -->
  <DrawingImage x:Key="PlaceholderIconImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFE9E9E9">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF8C8C8C" Thickness="1.5" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="4,2,24,28" RadiusX="3" RadiusY="3" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FF8C8C8C">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="9,9,14,2" />
              <RectangleGeometry Rect="9,14,14,2" />
              <RectangleGeometry Rect="9,19,9,2" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- The move grip; on a see-through background its dots have the names' edge (review 39 T3) -->
  <Style x:Key="GripStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Theme.GripPattern}" />
    <Setter Property="Effect" Value="{DynamicResource Theme.TextEdge}" />
    <Setter Property="Margin" Value="4,6,3,6" />
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>

  <!-- Small glyph buttons on the right edge of the bar -->
  <Style x:Key="BarButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.PointerOver}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The glyph of a bar button (✕, ▸, ←): on a see-through background it has the names' edge (review 39 T3) -->
  <Style x:Key="BarGlyphStyle" TargetType="TextBlock">
    <Setter Property="Effect" Value="{DynamicResource Theme.TextEdge}" />
  </Style>

  <!-- Small text buttons inside the bar (the Undo of the removal banner) -->
  <Style x:Key="BarTextButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButtonStyle}">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The type-to-find box of the bar and of the Show-at-pointer window -->
  <Style x:Key="SearchBoxStyle" TargetType="TextBox">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource Theme.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Theme.Foreground}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- What Enter opens, shown beside the search box (the match may sit inside a closed group); it stands on the bare
       background, so on a see-through one it has the names' edge (review 39 T3) -->
  <Style x:Key="SearchTargetStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Hint}" />
    <Setter Property="Effect" Value="{DynamicResource Theme.TextEdge}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="6,0,2,0" />
  </Style>

  <!-- Icon cells -->
  <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="5"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.PointerOver}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.PointerOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Focus}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.DropTarget}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Focus}" />
            </DataTrigger>
            <!-- Not found on this PC -->
            <DataTrigger Binding="{Binding IsMissing}" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.55" />
            </DataTrigger>
            <!-- Type to find: the rest fades, and the match Enter opens gets a frame -->
            <DataTrigger Binding="{Binding IsSearchDimmed}" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.3" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSearchSelected}" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Hover}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Focus}" />
            </DataTrigger>
            <!-- Launch feedback: framed while the program comes up, and pulsing unless Windows animations are off -->
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsLaunching}" Value="True" />
                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard x:Name="LaunchPulse">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.4" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions>
                <RemoveStoryboard BeginStoryboardName="LaunchPulse" />
              </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Separators among the icons: a divider, an empty cell or a caption; outlined under the pointer so they can be found -->
  <Style x:Key="SeparatorButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.PointerOverBorder}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Theme.Focus}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSearchDimmed}" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.3" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dialog pieces -->
  <Style x:Key="DialogLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DialogTextBox" TargetType="TextBox">
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="DialogButton" TargetType="Button">
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>

  <!-- The text of a check box or an option, wrapping instead of running past the dialog's edge (long in some languages).
       Set as ContentTemplate on each one: an implicit style would hide the Fluent dialog style. -->
  <DataTemplate x:Key="WrappingLabel">
    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
  </DataTemplate>

  <!-- A hint under a field or a choice: told apart by its place (close under what it explains, a negative top margin),
       drawn in the dialog's own text colour, inherited, so it reads as well as a label in the classic and the Fluent
       look, light or dark, and in High Contrast (0.13.0 WP3: it was grey). A disabled one is faded with its row. -->
  <Style x:Key="DialogHint" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,-4,0,8" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
