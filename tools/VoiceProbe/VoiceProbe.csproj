<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The 0.7.0 voice spike (docs/ROADMAP.md #11): can an unpackaged desktop process recognise a list of names with
    the Windows speech recogniser, in zh-TW, on Windows 11? Not part of the app, its solution or its release; run it
    on a Windows PC with a microphone as FEATURES.md §6.1 describes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Only for this trial, not for the app: Microsoft's managed wrapper over the desktop recognisers (SAPI), to see
    whether they hear the names where the newer recogniser cannot be created. Whether the app may use it (or reach
    SAPI without a package) is the owner's decision, after the trial.
  -->
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

</Project>
